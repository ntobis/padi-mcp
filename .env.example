# Local MCP server — everything below is OPTIONAL.
# The defaults target PADI's live service and the in-repo session file.

# Where to store the session file. Defaults to inputs/session.json next to
# the built dist/ (resolves correctly even if the server is launched from a
# different working directory by an MCP host app).
# PADI_SESSION_PATH=/absolute/path/to/session.json

# Override the Cognito login target if PADI changes it.
# PADI_COGNITO_REGION=us-west-2
# PADI_COGNITO_CLIENT_ID=2arn5r23p0ugce89a5moe95v1l

# Override the logbook GraphQL endpoint.
# PADI_ENDPOINT=https://logbook.global-prod.padi.com/api/Logbook

LOG_LEVEL=info
