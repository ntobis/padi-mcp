:uun,action:cun,deactivate:mun,edit:gun,active:pun,inactive:hun,rows_per_page:fun,password:vun,email:yun,optional:bun,renew_now:kun,status:wun,in_progress:Pun,processed:Sun,processing_failed:Aun,participant_name:Cun,forms:zun,completed:Iun,bulk_process_selected:Dun,download_selected:Eun,participant:jun,e_learning:Tun,dive_pro:xun,details:Run,view:Mun,reload:$un,text_trouble_loading_data:Lun,showing_pagination_label:Oun,program:Nun,from:Fun,date:qun,signed:Bun,complete:Vun,all:Hun,new:\"Ny\",empty_table_text:Kun,limitations:Uun,birth_date:Gun,certification_card:Wun,card_type:Jun,card_back:Yun,format:Zun,padi_club_45_day_trial:Qun,free_trial:Xun,padi_club_membership_includes_exclusive_discounts_on_dive_courses_travel_an_annual_subscription_to_scuba_diving_magazine_and_more_if_you_are_in_the_us_provide_your_shipping_address_to_receive_your_paper_copy_of_the_magazine_customers_outside_the_us_will_receive_the_digital_version_please_note_padi_club_is_currently_available_in_english_only:ecn,membership_includes:acn,\"20_off_select_padi_e_learning_courses\":\"20% rabatt på utvalgte PADI eLearning-kurs\",annual_subscription_to_scuba_diving_magazine:tcn,\"5_of_your_membership_fee_supports_ocean_conservation_efforts_around_the_globe\":\"5% av medlemsavgiften din går til å støtte bevaringsarbeid for havet over hele verden\",free_reactivate_online_refresher:icn,dan_prepared_diver_course:ncn,\"20_off_padi_merchandise\":\"20% rabatt på PADI™-varer\",member_credit_for_padi_travel:rcn,\"20_off_sea_life_i_phone_underwater_housing\":\"20% rabatt på SeaLife® iPhone-undervannshus\",try_it_for_free_for_45_days_at_the_end_of_the_trial_period_you_decide_whether_or_not_to_subscribe:ocn,promotional_code:scn,apply:lcn,estimated_subtotal:_cn,item:dcn,items:ucn,promotion:ccn,estimated_tax:mcn,tax_calculated_at_checkout:gcn,project_aware_donation:pcn,shipping_handling:hcn,unfortunately_we_are_unable_to_place_orders_right_now_please_try_again_soon:fcn,continue_shopping:vcn,enter_coupon_code:ycn,pa