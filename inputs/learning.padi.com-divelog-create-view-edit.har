=\"program\",_et=\"Od\",det=\"Datum\",uet=\"Potpisano\",cet=\"Završeno\",met=\"Sve\",get=\"Trenutno nemate niti jednog DSD sudionika.\",pet=\"Ogranicenja\",het=\"Datum rođenja \",fet=\"Certifikacijska kartica\",vet=\"Vrsta kartice\",yet=\"stražnja strana kartice:\",bet=\"Format:\",ket=\"PADI Club probnih 45 dana\",wet=\"Besplatno probno razdoblje\",Pet=\"PADI Club članstvo uključuje ekskluzivne popuste na ronilačke tečajeve i putovanja, godišnju pretplatu za Scuba Diving časopis i još više. Ukoliko ste u SAD-u pošaljite svoju adresu kako bi dobivali časopis u papirnatom obliku. Stranke izvan SAD-a dobivati će digitalni oblik. PADI Club je dostupan isključivo na engleskom jeziku.\",Aet=\"Članstvo uključuje:\",Cet=\"Godišnju članarinu za Scuba Diving časopis\",zet=\"Besplatnu Reactivate online obnovu\",Iet=\"DAN® pripremu\",Det=\"Kredit za članove PADI Travel\",Eet=\"Besplatno probajte 45 dana. Na kraju probnog roka odlučujete da li se pretplatiti ili ne.\",jet=\"Promotivni kod\",Tet=\"Primijeni\",xet=\"Procijenjeni zbroj\",Ret=\"Stavka\",Met=\"Stavke\",$et=\"Promocija\",Let=\"Procijenjene pristojbe\",Oet=\"Pristojbe izračunate kod izlaza\",Net=\"Donacija za Project AWARE \",Fet=\"Otprema & uručivanje\",qet=\"Nažalost trenutno ne možemo slati narudžbe. Probajte ponovno kasnije.\",Bet=\"Nastavite sa kupnjom \",Vet=\"Upišite kod kupona\",Het=\"Način plaćanja \",Ket=\"Kreditna ili debitna kartica\",Uet=\"Datum isteka(MM/YY)\",Get=\"Od\",Wet=\"Aktivan\",Jet=\"Siguran izlaz iz aplikacije\",Yet=\"Prihvaćeni mobilni novčanik i glavna kreditna kartica:\",Zet=\"Plaćanje u ratama\",Qet=\"Engleski\",Xet=\"Primarno\",eat=\"Radno\",aat=\"Mobilni  \",tat=\"Ne\",iat=\"Sij\",nat=\"Velj\\n\",rat=\"Ožu \",oat=\" Trav\",sat=\"Lip \",lat=\"Srpanj\",_at=\"Kol \",dat=\"Ruj \",uat=\"Ruj \",cat=\"List \",mat=\"Stu \",gat=\"Pro \",pat=\"U redu\",hat=\"Pošalji\",fat=\"Natrag na početnu\",vat=\"Ostalo\",yat=\"Preskoči\",bat=\"Natrag\",kat=\"Certificiranje\",wat=\"Planiranje\",Pat=\"Članski broj\",Sat=\"Pretraživanje\",Aat=\"Trgovina\",Cat=\"Račun\",zat=\"Potvrde i vjerodajnice\",Iat=\"Niste pronašli e Karticu\",Dat=\"eKartica uz ovaj certifikat nije dostupna\",Eat=\"Zamijeni moju fizičku karticu\",jat=\"Kupite e-karticu\",Tat=\"Datum rođenja\",xat=\"KVALIFIKACIJA\",Rat=\"Osvježite\",Mat=\"PADI Travel\",$at=\"Postavke\",Lat=\"Jezik\",Oat=\"Profil\",Nat=\"Muško\",Fat=\"Grad\",qat=\"Država\",Bat=\"Spremi\",Vat=\"Odustani\",Hat=\"Slijedeće\",Kat=\"Pokušajte ponovno\",Uat=\"Kontakt\",Gat=\"Ronilačka knjižica\",Wat=\"Sva vaša ronjenja na jednom mjestu.\",Jat=\"Početak\",Yat=\"Kada počnete upisivati ronjenja tijekom vašeg ronilačkog putovanja, ona će se pojaviti ovdje.\",Zat=\"Upišite ronjenje iz obuke\",Qat=\"Upišite rekreacijsko ronjenje\",Xat=\"stopa\",ett=\"stopa\",att=\"minute\",ttt=\"Obuka\",itt=\"Rekreacijsko\",ntt=\"Nacrti\",rtt=\"Općenito\",ott=\"Naslov ronjenja\",stt=\"Lokacija ronjenja\",ltt=\"Vrsta zarona\",_tt=\"Kako želite nazvati svoj zaron?\",dtt=\"Gdje ste ronili?\",utt=\"Navedite datum vašeg zarona.\",ctt=\"Koji je PADI broj vašeg instruktora?\",mtt=\"Kako ste ušli u vodu?\",gtt=\"Dodaj\",ptt=\"PADI broj\",htt=\"Obala\",ftt=\"Brod\",vtt=\"Dubina/vrijeme\",ytt=\"Vrijeme ulaska\",btt=\"Vrijeme izlaska\",ktt=\"Maks. dubina\",wtt=\"Vrijeme ronjenja\",Ptt=\"Na koju ste dubinu išli?\",Stt=\"Koliko je trajalo vaše ronjenje?\",Att=\"Vještine obuke ronjenja\",Ctt=\"Vještine\",ztt=\"Fleksibilne\",Itt=\"Fleksibilne vještine\",Dtt=\"Vaš instruktor će odrediti kada ćete provesti ove vještine, ovisno o logistici i uvjetima.\",Ett=\"Nijedna fleksibilna vještina nije dovršena u ovom ronjenju\",jtt=\"Otklanjanje grčeva\",Ttt=\"Tegljenje umornog ronioca\",xtt=\"Signalna plutača za napuhavanje/uvođenje DSMB.\",Rtt=\"Odbacivanje utega u slučaju nužde (ili u OGR.V)\",Mtt=\"Izmjena disalice/regulatora\",$tt=\"Skidanje i ponovno stavljanje opreme (na površini)\",Ltt=\"Skidanje/ponovno stavljanje utega (na površini)\",Ott=\"Površinsko plivanje s kompasom\",Ntt=\"Podvodna navigacija s kompasom (ronjenje 2, 3 ili 4)\",Ftt=\"Kontrolirani slobodni izron (ronjenje 2,3 ili 4)\",qtt=\"Prepoznavanje signala s rukom\",Btt=\"Priprema opreme, stavljanje i prilagodba\",Vtt=\"Sigurnosna provjera prije zarona\",Htt=\"Ulazak\",Ktt=\"Provjera plovnosti/težine\",Utt=\"Kontrolirani zaron\",Gtt=\"Provjera trima\",Wtt=\"Pražnjenje napola napunjene maske\",Jtt=\"Traženje/pražnjenje regulatora\",Ytt=\"Podvodno istraživanje\",Ztt=\"Signal za dovod zraka\",Qtt=\"Ostanite blizu buddyja\",Xtt=\"Izron\",eit=\"Izlaz\",ait=\"Planiranje ronjenja\",tit=\"Ulazak i provjera utega\",iit=\"Signal za mjesto zaokreta\",nit=\"Oralno napuhavanje KP-a (na površini)\",rit=\"Zaron\",oit=\"Kontrola plovnosti\",sit=\"Pražnjenje potpuno napunjene maske \",lit=\"Alternativni izvor zraka/izron\",_it=\"Izbjegavanje kontakta\",dit=\"Slobodan zaron s vizualnom referencom\",uit=\"Skidanje/ponovno stavljanje maske\",cit=\"Vrsta vode\",mit=\"Tijelo vode\",git=\"Vremenski uvjeti\",pit=\"Temperatura\",hit=\"Temperatura zraka\",fit=\"Temperatura na površini\",vit=\"Temperatura na dnu\",yit=\"Vidljivost\",bit=\"Valovi\",kit=\"Strujanje\",wit=\"Uzburkanost\",Pit=\"Koja je vrsta vode to bila?\",Sit=\"U kojem ste dijelu ronili?\",Ait=\"Kakvo je bilo vrijeme?\",Cit=\"Koja je bila temperatura?\",zit=\"Koja je bila temperatura zraka?\",Iit=\"Koja je bila temperatura površine?\",Dit=\"Koja je bila temperatura dna?\",Eit=\"Koja je bila vidjljivost?\",jit=\"Koliko ste daleko mogli vidjeti?\",Tit=\"Kakvi su bili valovi?\",xit=\"Kakva je bila struja?\",Rit=\"Kakva je bila uzburkanost?\",Mit=\"Slanost\",$it=\"Ocean\",Lit=\"Sunčano\",Oit=\"°F\",Nit=\"°C\",Fit=\"Visoko\",qit=\"Nema\",Bit=\"Svijetlo\",Vit=\"Slatka\",Hit=\"Jezero\",Kit=\"Djelomično oblačno\",Uit=\"Prosječno\",Git=\"Malo\",Wit=\"Nisko\",Jit=\"Srednje\",Yit=\"Rijeka\",Zit=\"Kišovito\",Qit=\"Veliko\",Xit=\"Jako\",ent=\"Vjetrovito\",ant=\"Maglovito\",tnt=\"Oprema\",int=\"Odijelo\",nnt=\"Uteg\",rnt=\"Dodatna oprema\",ont=\"Boca\",snt=\"Mješavina plinova\",lnt=\"Pritisak u boci\",_nt=\"Početni tlak\",dnt=\"Krajnji pritisak\",unt=\"Korištena količina\",cnt=\"Koje odijelo ste nosili?\",mnt=\"Koja je količina utega koje ste koristili?\",gnt=\"Koju drugu opremu ste nosili?\",pnt=\"Koji tip boce ste koristili?\",hnt=\"Koja je bila veličina boce?\",fnt=\"Zrak\",vnt=\"PSI\",ynt=\"S koliko ste počeli?\",bnt=\"Koliko je bilo ostalo?\",knt=\"Ovo će biti automatski izračunato.\",wnt=\"lbs\",Pnt=\"Kapuljača\",Snt=\"Čelik\",Ant=\"kubične stope / kubičnih stopa\",Cnt=\"lit(a)ra\",znt=\"EANx32\",Int=\"bar\",Dnt=\"Kompletno odijelo 3 mm\",Ent=\"Rukavice\",jnt=\"Aluminij\",Tnt=\"EANx36\",xnt=\"Kompletno odijelo 5 mm\",Rnt=\"Dobro\",Mnt=\"Čizme\",$nt=\"EANx40\",Lnt=\"Kompletno odijelo 7 mm\",Ont=\"Teško\",Nnt=\"Obogaćeno\",Fnt=\"Kratko\",qnt=\"Polusuho\",Bnt=\"Suho odijelo\",Vnt=\"Rebreather\",Hnt=\"Kisik\",Knt=\"Dušik\",Unt=\"Helij\",Gnt=\"Iskustvo\",Wnt=\"Osjećaj\",Jnt=\"Napomena\",Ynt=\"Buddy\",Znt=\"Ronilački centar\",Qnt=\"Kako ste se osjećali u vezi ovog ronjenja?\",Xnt=\"Zapišite sjećanja o vašem ronjenju\",ert=\"S kim ste išli?\",art=\"S kojim ste ronilačkim centrom ronili?\",trt=\"Nevjerojatno\",irt=\"Loše\",nrt=\"Uspješno!\",rrt=\"O-o!\",ort=\"Uspješno ste poslali upisano ronjenje svom instruktoru. Provjerite uskoro status vaše ronilačke knjižice.\",srt=\"Došlo je do pogreške i ne možemo objaviti ovaj dnevnik ronjenja.\",lrt=\"U međuvremenu dodajte dodatne podatke vašeg zabilježenog zarona prije nego ih zaboravite. Ovo je izborno i možete se vratiti i uraditi to bilo kada.\",_rt=\"Natrag na ronilačku knjižicu.\",drt=\"Upišite zaron u ronilačku knjižicu           \",urt=\"Spremite u nacrte\",crt=\"Pošaljite na provjeru\",mrt=\"Odaberite tečaj i broj zarona obuke\",grt=\"Odaberite zaron obuke\",prt=\"Open Water Diver\",hrt=\"Ronjenja u otvorenim vodama 1\",frt=\"Ronjenje u otvorenim vodama 2\",vrt=\"Ronjenje u otvorenim vodama 3\",yrt=\"Ronjenje u otvorenim vodama 4\",brt=\"Upisali ste sva ronjenja iz obuke ovoga tečaja.\",krt=\"Vidi svoje tečajeve\",wrt=\"Upišite naziv\",Prt=\"Upišite lokaciju\",Srt=\"Datum\",Art=\"Odaberite vrstu ronjenja\",Crt=\"Upišite instruktora\",zrt=\"Nevažeći broj instruktora\",Irt=\"Nedostaju obavezna polja\",Drt=\"Opće i maksimalno vrijeme\\n\",Ert=\"Opće i vještine iz obuke ronjenja\",jrt=\"Dubina/vrijeme i vještine iz obuke ronjenja\",Trt=\"Općenito, dubina/vrijeme i vještine iz obuke ronjenja \",xrt=\"Upišite maksimalnu dubinu\",Rrt=\"Upišite maksimalno vrijeme\",Mrt=\"Kontrola plovnosti/Oralno napuhavanje\",$rt=\"Planirajte pomoću pločice za ronjenje\",Lrt=\"Slobodan zaron bez reference\",Ort=\"Sigurnosni zastoj\",Nrt=\"Odaberite najmanje 1 vještinu\",Frt=\"\\nSpremni poslati \",qrt=\"met(a)ra\",Brt=\"kamenita obala\",Vrt=\"oblačno\",Hrt=\"Koju vrstu plina ste koristili?\",Krt=\"Ukupno ronjenja\",Urt=\"Vrijeme ronjenja\",Grt=\"Uvjeti\",Wrt=\"kilograma\",Jrt=\"Nastavite upisivanje u ronilačku knjižicu\",Yrt=\"Slanje instruktoru\",Zrt=\"Učitavanje ronjenja upisanih u ronilačku knjižicu\",Qrt=\"Fotografije\",Xrt=\"Što ste vidjeli tijekom ronjenja?\",eot=\"JPG, PNG (10MB maksimalno po fotografiji)\",aot=\"Sastavljanje i pozicioniranje opreme za prvu pomoć\",tot=\"Opiši i zabilježi promjenu boja u dubini\",iot=\"Usporedba ronilački kompjutor / dubinomjer\",not=\"Korištenje kompasa na kopnu\",rot=\"Plivanje\",oot=\"Procjena vremena plivanja\",sot=\"Korištenjem prirodne navigacije navigirajte po pravcu i povratnom smjeru\",lot=\"Korištenjem prirodne navigacije navigirajte po pravcu i povratnom smjeru\",_ot=\"Korištenjem kompasa navigirajte u kvadrat\",dot=\"Ulazak u vodu sa broda\",uot=\"Navigiraj od i prema brodu\",cot=\"Pripremi tubularnu plutaču na napuhavanje\",mot=\"Izlaz iz mora na brod\",got=\"Spremi opremu\",pot=\"Postavljanje sustava kamere\",hot=\"Fotografije i video slike\",fot=\"Ronjenje uz strujanja\",vot=\"Kontrola plovnosti sa suhim odijelom\",yot=\"Neutralna plovnost\",bot=\"Ronjenje u suhom odijelu\",kot=\"Skidanje i ponovno stavljanje ronilačke opreme i sustava utega na površini\",wot=\"Priprema pločice\",Pot=\"Pratite i identificirajte riblje skupine\",Sot=\"Zabilježite promatranja\",Aot=\"Nacrtajte/Opišite nepoznate ribe\",Cot=\"Demonstrirajte ronjenje prihvatljivo za očuvanje okoliša\",zot=\"Koristite referentne materijale za identifikaciju nepoznatih vrsta riba\",Iot=\"Učinkovita komunikacija i korištenje lampi.\",Dot=\"Navigacija\",Eot=\"Vođene ture\",jot=\"Kontrola plovnosti\",Tot=\"Neutralna plovnost tijekom zaranjanja\",xot=\"Lebđenje\",Rot=\"Fino podešavanje uz kontrolu disanja\",Mot=\"Vježbanje pretraživanja na kopnu\",$ot=\"Vježbanje namještanja objekata na kopnu\",Lot=\"Pretraživanje malog područja\",Oot=\"Pretraživanje većeg područja\",Not=\"Vezanje čvorova pod vodom\",Fot=\"Namještanje i podizanje objekta\",qot=\"Identificirajte podvodne biljke\",Bot=\"Identificirajte i promatrajte vodene bezkralježnjake\",Vot=\"Identificirajte i promatrajte vodene kralježnjake\",Hot=\"Upisivanje ronjenja - ispunite zapis obuke\",Kot=\"Pitanja za ponavljanje\",Uot=\"Brifing, zadatci i planiranje\",Got=\"Opremanje\",Wot=\"Sigurnosna kontrola opreme prije ronjenja (KSKIP)\",Jot=\"Navigacija na olupini\",Yot=\"Povratak do točke izranjanja\",Zot=\"Izranjanje - sigurnosni zastoj\",Qot=\"Debrifing: Samokritika i procjena izvođenja\",Xot=\"Upisivanje ronjenja - ispunite zapis obuke\",est=\"Vrste Adventure ronjenja\",ast=\"Koje avanturističko ronjenje ste napravili?\",tst=\"Odaberite avanturističko ronjenje\",ist=\"Vrsta ronjenja\",nst=\"Ronjenje iz obuke\",rst=\"Odaberite tečaj\",ost=\"Spremi \",sst=\"Ronjenje\",lst=\"Scenarij 1 - Ronilac koji ne reagira pod vodom\",_st=\"Tijekom simulacije nesreće tražite i locirajte nastalog ronioca. Demonstrirajte:\",dst=\"Scenarij 2 - Ronilac koji ne reagira na površini\",ust=\"Pokazati:\",cst=\"Uputa: Za OSP koristiti lutku ili simulirati kompresije za OSP\",mst=\"Vježba 1: Umorni ronilac\",gst=\"Vježba 2: Ronilac u panici\",pst=\"Vježba 3: Pružanje pomoći s obale, broda ili gata (Ronilac koji reagira)\",hst=\"Vježba 4: Ronilac u stresu pod vodom\",fst=\"Vježba 5: Nestali ronilac\",vst=\"Vježba 6: Izranjanje s roniocem koji ne reagira\",yst=\"Vježba 7: Ronilac koji ne odgovara na površini\",bst=\"Vježba 8: Izlazak s roniocem koji ne reagira\",kst=\"Vježba 9: Prva pomoć za ozljede izazvane pritiskom i davanje kisika\",wst=\"Vježba 10: Pružanje pomoći s obale/broda (ronilac koji ne reagira)\",Pst=\"Obavijesti\",Sst=\"Danas\",Ast=\"Starije\",Cst=\"Zaštita mora\",zst=\"Podrška\",Ist=\"Izvedba\",Dst=\"Alati\",Est=\"PADI Pro\",jst=\"PADI klub\",Tst=\"Discover Scuba Diving\",xst=\"Ili\",Rst=\"I\",Mst=\"Štampano\",$st=\"Datum (dd/mm/gggg)\",Lst=\"Rev\",Ost=\"Verzija\",Nst=\"E-kartice\",Fst=\"Odaberite bilo koju karticu za detalje\",qst=\"Trenutačno nemate nikakvih e-kartica spojenih s vašim računom.\",Bst=\"Kupi cert. karticu\",Vst=\"Nije pronađen niti jedan PADI program\",Hst=\"Zaronite s jednim od naših početnih programa za ronjenje, ronjenje na dah ili sirenu. Ako mislite da je ovo pogreška, obratite se našem timu za odnose s klijentima.\",Kst=\"Vidi više\",Ust=\"Kontaktirajte nas\",Gst=\"Pogledajte tečajeve početne razine\",Wst=\"Odaberite po\",Jst=\"Ime (A-Z)\",Yst=\"Ime (Z-A)\",Zst=\"Najpopularnije\",Qst=\"Cijena: od najniže do najviše\",Xst=\"Cijena: Od najviše do najniže\",elt=\"Certificiranje bez eKartice \",alt=\"Nije pronađen certifikat \",tlt=\"Nema dodatnih certifikata bez eKartice\",ilt=\"Vidi sve\",nlt=\"Sve eKartice\",rlt=\"Asistencija kod pripreme opreme, sastavljanja i namještanja\",olt=\"Pravila disanja i tehnike izjednačavanja pritiska\",slt=\"tečajevi\",llt=\"Ukupno vrijeme ronjenja \",_lt=\"Lokacija\",dlt=\"Datum zarona\",ult=\"Učitajte fotografiju\",clt=\"Advanced Open Water\",mlt=\"Rescue ronilac\",glt=\"ReActivate\",plt=\"Prethodno\",hlt=\"Trimix\",flt=\"Odabrani datum nije odobren\",vlt=\"QR kod potvrđen\",ylt=\"Neobavezno, ali se zahtijeva ukoliko želite da PADI Pro  ovjeri vaše ronjenje.\",blt=\"Važno\",klt=\"Molimo provjerite točnost informacija o vama. Morate <b> imati</b>fotografiju na vašem profilu ili nećete moći doiti svoju eKarticu. Da bi osvježili informacije i učitali aktualnu fotografiju, molimo idite na svoj <a href='/profile' target='_blank' class='profile-link'>profile</a>.\",wlt=\"Srednje ime\",Plt=\"PADI eKartica<sup>TM</sup> je uključena bez dodatnih pristojbi.\",Slt=\"Vaš instruktor je kupnjom PADI AWARE eKartice donirao da bi podržao zaštitu podmorja<sup>TM</sup>. Donacija ce biti direktno poslana za podršku aktivnosti PADI centara i resorta radi održavanja zdravlja koralja, zaštite morskih pasa, smanjenja onečišćenja podmorja i klimatskih promjena.  \\n \",Alt=\"Pošaljite prijavu\",Clt=\"Potvrđujem da je potpis moj osobno\",zlt=\"Ime i prezime\",Ilt=\"Utipkajte svoj potpis\",Dlt=\"Potpišite se\",Elt=\"PADI Center\",jlt=\"Odgovorna osoba za plaćanje\",Tlt=\"Pristojba prijave\",xlt=\"Uz dodatnih 10 eura zaštitu možete podržati kupnjom PADI AWARE eKartice<sup>TM</sup>. Pristojba kartice i bilo kakvi dodatni troškovi donacija biti će direktno poslani PADI centrima za njihove aktivnosti održavanja koralja zdravim, zaštite morskih pasa, smanjenja onečišćenja podmorja i klimatskih promjena.  \\n \",Rlt=\"Neobavezna dodatna donacija\",Mlt=\"Nadogradnja na PADI AWARE eKarticu\",$lt=\"zahtjev za donaciju\",Llt=\"Pristojba prijave plaćena od\",Olt=\"Pristojba za prijavu pokriva postupak razine članstva novoga člana. Kada je certificiran/a, konačne pogodnosti članstva produljene su do kraja te kalendarske godine. Da bi nastavili sa članstvom slijedeće godine i dalje, potrebna je godišnja obnova članstva.\",Nlt=\"Prijavite se za automatsku obnovu kako bi bili sigurni da vam članstvo ili pogodnosti ne isteknu i uplatite po najnižoj cijeni članstva! \",Flt=\"Da, upišite me za Automatsku obnovu. Pročitao/la sam i suglasan/sna sam sa\",qlt=\"PADI Ugovorom za Automatsku obnovu članstva\",Blt=\"u potpunosti\",Vlt=\"Siguran način plaćanja\",Hlt=\"Uplatio/la:\",Klt=\"Potpis (ili, ukoliko se radi o maloljetniku, zahtijeva se potpis roditelja/staratelja)\",Ult=\"Potpis \",Glt=\"Preduvjeti moraju biti ili PADI certifikati ili ista razina obuke neke druge organizacije za obuku.\",Wlt=\"Više informacija\",Jlt=\"Vaš instruktor tražit će vas dokaz o certificiranju\",Ylt=\"Završetak certificiranja\",Zlt=\"Datum završetka tečaja\",Qlt=\"Instruktor\",Xlt=\"Kandidat\",e_t=\"Pristojba AWARE eKartice\",a_t=\"Pristojba PADI AWARE eKartice\",t_t=\"Upišite se za Automatsku obnovu\",i_t=\"PADI AWARE donacija\",n_t=\"Kreditna kartica\",r_t=\"PADI će vam, kada prijava bude obrađena, poslati sigurnu poveznicu za plaćanje.\",o_t=\"Žični transfer\",s_t=\"PADI Customer Relations će vas, radi daljnjih uputa, kontaktirati nakon što prijava bude obrađena. \",l_t=\"PayPal\",__t=\"PADI Customer Relations će vas, radi daljnjih uputa za Pay Pal, kontaktirati nakon što prijava bude obrađena. \",d_t=\"Drugi način plaćanja\",u_t=\"PADI Customer Relations će vas, radi daljnjih uputa, kontaktirati nakon što prijava bude obrađena. \",c_t=\"Molimo navedite željeni način plaćanja. Nemojte upisivati osjetljive podatke bankovnog računa. (Maksimalno 300 znakova) \",m_t=\"Poruka\\n\",g_t=\"Imati najmanje 40 ronjenja upisanih u ronilačku knjižicu\",p_t=\"Imati liječničko uvjerenje da nema kontraindikacija za bavljenje ronjenjem, ne starije od 12 mjeseci.\",h_t=\"PADI eKartica<sup>TM</sup> je uključena bez dodatnih pristojbi.\",f_t=\"Ugovor za Instruktora\",v_t=\"Pribavio/la sam potrebne aktualne materijale za EFR instruktore i upoznao/la se sa sadržajem. Razumijem da ne mogu provoditi nikakve tečajeve hitne prve pomoći (EFR) dok ne primim ovlaštenje od EFR-a. Nadalje se slažem da ću prilikom provođenja EFR tečajeva poštovati sve EFR standarde i postupke koji su objavljeni i ažurirani od strane EFR-a. Održavat ću poznavanje EFR materijala za naobrazbu, uključujući revizije postojećih materijala i uvođenje novih materijala. Potvrđujem da sam pročitao/la i da ću se pridržavati Ugovora o licenci EFR-a koji se nalazi u Dodatku Vodiča za EFR instruktore. Razumijem i slažem se da bilo koja moja kaznena presuda koja uključuje zlostavljanje maloljetnika ili seksualno zlostavljanje odrasle osobe, bilo tijekom ili prije mog certifikata kao EFR instruktora, automatski predstavlja osnovu za odbijanje ili opoziv mojih certifikata. Također razumijem da EFR može odbiti prihvatiti moju prijavu ili opozvati sve EFR instruktorske certifikate koje možda posjedujem.\",y_t=\"Da bi pristupio/la Emergency First Response Instructor tečaju, pojedinac mora:\",b_t=\"Imati završen EFR primarni i sekundarni tečaj (ili istu razinu obuke) unutar zadnja 24 sata.\",k_t=\"Imati 18 godina.\",w_t=\"Specialty / Distinctive\",P_t=\"Specialty ili Distinctive\",S_t=\"Koje ronjenje ste završili?\",A_t=\"Koje vještine ste završili?\",C_t=\"Molimo, provjerite da li su informacije točne. Da bi obnovili informacije, molimo idite na <a href='/profile' target='_blank' class='profile-link'>Profil</a>\",z_t=\"Ukupan postotak plinova mora iznositi 100%.\",I_t=\"Informacije o kandidatu\",D_t=\"Pročitao/la sam<a target='_blank' href='{membershipAgreementLink}'>Ugovor o članstvu i Ugovor o licenci</a> i ovime pristajem i prihvaćam uvjete i odredbe u cijelosti. Razumijem i slažem se da će svaka moja kaznena osuda koja uključuje zlostavljanje maloljetnika ili seksualno zlostavljanje odrasle osobe, bilo tijekom ili prije mog članstva u PADI, biti automatski razlog za odbijanje ili prekid mog članstva u PADI. Ovime potvrđujem da su sve gore navedene izjave istinite i točne u skladu s mojim najboljim saznanjima. \",E_t=\"Potvrđujem da su svi preduvjeti i zahtjevi certificiranja za ovdje navedenog EFR Instruktorskog kandidata ispunjeni kao što je navedeno i u EFR Instructor Trainer priručniku. \",j_t=\"Ovime potvrđujem da sam pribavio/la, pregledao/la i potvrdio/la sve temeljne (preduvjetne) dokaze o završetku tečajeva za ovdje navedenog kandidata za EFR instruktora. Nadalje potvrđujem da ću trajno čuvati kopije takvih obveznih dokaza o završetku tečajeva i svih ostalih dokumenata dobivenih kao dokaz o ispunjavanju preduvjeta kandidata za uvid od strane PADI/EFR-a, ukoliko PADI/EFR to zatraži.\",T_t=\"Potvrđujem da je ovdje navedeni EFR Instructor kandidat kupio kopiju materijala za EFR Instructor obuku ili taj uvjet može biti izuzet iz PADI standarda.\",x_t=\"Ovime potvrđujem da sam pribavio/la, pregledao/la i potvrdio/la sve temeljne (preduvjetne) dokaze o završetku tečajeva za ovdje navedenog Divemaster kandidata. Nadalje potvrđujem da ću trajno čuvati kopije takvih obveznih dokaza o završetku tečajeva i svih ostalih dokumenata dobivenih kao dokaz o ispunjavanju preduvjeta kandidata za uvid od strane PADI, ukoliko PADI.\",R_t=\"Potvrđujem da su svi preduvjeti i zahtjevi certificiranja za ovdje navedenog Divemaster kandidata ispunjeni kao što je navedeno i u PADI Instructor Manualu. \",M_t=\"Potvrđujem da je ovdje navedeni Divemaster kandidat kupio kopiju materijala za PADI Divemaster obuku ili taj uvjet može biti izuzet iz PADI standarda.\",$_t=\"Potvrđujem da ovdje navedeni Divemaster kandidat ima 60 ronjenja upisanih u ronilačku knjižicu, čime dokazuje iskustvo u noćnom ronjenju, dubinskom ronjenju i podvodnoj navigaciji.\",L_t=\"Potpis kandidata\",O_t=\"Plaćanje\",N_t=\"Preduvjeti kandidata\",F_t=\"Zahtjeva se dokaz o certifikatu iznad početne razine (najmanje ukupno dva certifikata); dokaz o 20 ili više ronjenja upisanih u ronilačku knjižicu, dokaz o iskustvu u dubinskom ronjenju i podvodnoj navigaciji.\",q_t=\"Zahtjeva se dokaz o rescue certifikatu.\",B_t=\"EFR Primarna skrb zahtjeva dokaz o OSP obuci unutar zadnja 24 mjeseca i EFR Sekundarna skrb zahtjeva dokaz o obuci o pružanju prve pomoći unutar zadnja 24 mjeseca. Tečajevi koji se mogu napraviti jedino online nisu prihvatljivi.\",V_t=\"Da bi ispunili uvjete za OSP i prvu pomoć za PADI tečajeve, OSP i tečaj prve pomoći moraju sadržavati vježbanje učenika i demonstraciju OSP i prve pomoći tehnika uz kvalificiranog instruktora. Tečajevi koji nemaju iste, online ili putem bilo kojeg drugog medija, nisu prihvatljivi.\",H_t=\"Zatvori\",K_t=\"Medicinska procjena \",U_t=\"Minimalan broj ronjenja upisanih u ronilačku knjižicu \",G_t=\"PADI Emergency First Response primarna i sekundarna skrb\",W_t=\"PADI Advanced Open Water Diver\",J_t=\"PADI Rescue ronilac\",Y_t=\"EFR eCard\",Z_t=\"PADI AWARE eCard\",Q_t=\"Potpis instruktora\",X_t=\"Potpis instruktora koji certificira\",edt=\"PADI eCard\",adt={update:qGa,remove:BGa,mark_as_read:VGa,Delete:HGa,january:KGa,february:UGa,march:GGa,april:WGa,may:JGa,june:YGa,july:ZGa,august:QGa,september:XGa,october:eWa,november:aWa,december:tWa,day:iWa,month:nWa,year:rWa,afghanistan:oWa,aland_islands:sWa,albania:lWa,algeria:_Wa,americanSamoa:dWa,andorra:uWa,angola:cWa,anguilla:mWa,antarctica:gWa,antigua_and_barbuda:pWa,argentina:hWa,armenia:fWa,aruba:vWa,australia:yWa,austria:bWa,azerbaijan:kWa,bahamas:wWa,bahrain:PWa,bangladesh:SWa,barbados:AWa,belarus:CWa,belgium:zWa,belize:IWa,benin:DWa,bermuda:EWa,bhutan:jWa,bolivia_plurinational_state_of:TWa,bosnia_and_herzegovina:xWa,botswana:RWa,brazil:MWa,british_indian_ocean_territory:$Wa,brunei_darussalam:LWa,bulgaria:OWa,burkina_faso:NWa,burundi:FWa,cambodia:qWa,cameroon:BWa,canada:VWa,cape_verde:HWa,cayman_islands:KWa,central_african_republic:UWa,chad:GWa,chile:WWa,china:JWa,christmas_island:YWa,cocos_keeling_islands:ZWa,colombia:QWa,comoros:XWa,congo:eJa,congo_the_democratic_republic_of_the_congo:aJa,cook_islands:tJa,costa_rica:iJa,cote_divoire:nJa,croatia:rJa,cuba:oJa,cyprus:sJa,czech_republic:lJa,denmark:_Ja,djibouti:dJa,dominica:uJa,dominican_republic:cJa,ecuador:mJa,egypt:gJa,el_salvador:pJa,equatorial_guinea:hJa,eritrea:fJa,estonia:vJa,ethiopia:yJa,falkland_islands_malvinas:bJa,faroe_islands:kJa,fiji:wJa,finland:PJa,france:SJa,french_guiana:AJa,french_polynesia:CJa,gabon:zJa,gambia:IJa,georgia:DJa,germany:EJa,ghana:jJa,gibraltar:TJa,greece:xJa,greenland:RJa,grenada:MJa,guadel