            "text": "{\"query\":\"query logbook_logs($name: String!) {\\n  logbook_dive_site(where: {name: {_ilike: $name}}) {\\n    id\\n    name\\n  }\\n}\",\"variables\":{\"name\":\"%Sipadan %\"}}"
