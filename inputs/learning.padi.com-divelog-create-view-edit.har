new_zealand:JW,nicaragua:YW,niger:ZW,nigeria:QW,niue:XW,norfolk_island:eJ,northern_mariana_islands:aJ,norway:tJ,oman:iJ,pakistan:nJ,palau:rJ,palestinian_territory_occupied:oJ,panama:sJ,papua_new_guinea:lJ,paraguay:_J,peru:dJ,philippines:uJ,pitcairn:cJ,poland:mJ,portugal:gJ,puerto_rico:pJ,qatar:hJ,romania:fJ,russia:vJ,rwanda:yJ,reunion:bJ,saint_barthelemy:kJ,saint_helena_ascension_and_tristan_da_cunha:wJ,saint_kitts_and_nevis:PJ,saint_lucia:SJ,saint_martin:AJ,saint_pierre_and_miquelon:CJ,saint_vincent_and_the_grenadines:zJ,samoa:IJ,san_marino:DJ,sao_tome_and_principe:EJ,saudi_arabia:jJ,senegal:TJ,serbia:xJ,seychelles:RJ,sierra_leone:MJ,singapore:$J,slovakia:LJ,slovenia:OJ,solomon_islands:NJ,somalia:FJ,south_africa:qJ,south_sudan:BJ,south_georgia_and_the_south_sandwich_islands:VJ,spain:HJ,sri_lanka:KJ,sudan:UJ,suriname:GJ,svalbard_and_jan_mayen:WJ,swaziland:JJ,sweden:YJ,switzerland:ZJ,syrian_arab_republic:QJ,taiwan:XJ,tajikistan:eY,tanzania_united_republic_of_tanzania:aY,thailand:tY,timor_leste:iY,togo:nY,tokelau:rY,tonga:oY,trinidad_and_tobago:sY,tunisia:lY,turkey:_Y,turkmenistan:dY,turks_and_caicos_islands:uY,tuvalu:cY,uganda:mY,ukraine:gY,united_arab_emirates:pY,united_kingdom:hY,united_states:fY,uruguay:vY,uzbekistan:yY,vanuatu:bY,venezuela_bolivarian_republic_of_venezuela:kY,vietnam:wY,virgin_islands_british:PY,virgin_islands_us:SY,wallis_and_futuna:AY,yemen:CY,zambia:zY,zimbabwe:IY,the_photo_exceeds_5mb_please_upload_a_photo_with_a_smaller_size:DY,required:EY,renewal_summary:jY,renewal_year_2021:TY,donate_to_project_aware:xY,more_info:RY,add_donation:MY,auto_renewal_fee:$Y,tax:LY,total:OY,credit_card_type:NY,secure_payment:FY,name_on_card:qY,card_number:BY,expiration_date_mm_yy:VY,cancel:HY,first_payment:KY,second_payment:UY,donation:GY,renewal_fee:WY,save_my_changes:JY,remove_donation:YY,enroll_in_auto_renewal:ZY,please_enter_a_valid_amount:QY,please_enter_a_valid_expiration_date:XY,enter_a_valid_card_number:eZ,please_enter_name_on_card:aZ,draft:tZ,pending:iZ,r