ates:zJr,uruguay:IJr,uzbekistan:DJr,vanuatu:EJr,venezuela_bolivarian_republic_of_venezuela:jJr,vietnam:TJr,virgin_islands_british:xJr,virgin_islands_us:RJr,wallis_and_futuna:MJr,yemen:$Jr,zambia:LJr,zimbabwe:OJr,the_photo_exceeds_5mb_please_upload_a_photo_with_a_smaller_size:NJr,required:FJr,renewal_summary:qJr,renewal_year_2021:BJr,donate_to_project_aware:VJr,more_info:HJr,add_donation:KJr,auto_renewal_fee:UJr,tax:GJr,total:WJr,credit_card_type:JJr,secure_payment:YJr,name_on_card:ZJr,card_number:QJr,expiration_date_mm_yy:XJr,cancel:eYr,first_payment:aYr,second_payment:tYr,donation:iYr,renewal_fee:nYr,save_my_changes:rYr,remove_donation:oYr,enroll_in_auto_renewal:sYr,please_enter_a_valid_amount:lYr,please_enter_a_valid_expiration_date:_Yr,enter_a_valid_card_number:dYr,please_enter_name_on_card:uYr,draft:cYr,pending:mYr,resubmit:gYr,verified:pYr,\"2022_padi_member_renewal_pricing_will_be_published_in_fall_2021_youll_have_the_option_to_update_your_renewal_selection_after_pricing_is_published\":\"Ang presyo sa pagre-renew ng Pagiging Miyembro ng PADI ay ihahayag sa Kapanahunang Taglagas ng 2021. Maaari mong i-update ang iyong napili sa pagre-renew matapos maihayag ang presyo.\",file_size_limit:hYr,select_file:fYr,retry_upload:vYr,save:yYr,are_you_sure_you_want_to_delete_this_photo:bYr,delete_photo:kYr,edit_photo:wYr,completion_date:PYr,reactivate_date:SYr,padi_no:AYr,instructor:CYr,address:zYr,phone:IYr,name:DYr,qualifications:EYr,shop:jYr,savings:TYr,auto_renewal:xYr,auto_renewal_payment_plan:RYr,one_time_renewal:MYr,add_new_user:$Yr,username:LYr,first_name:OYr,last_name:NYr,role:FYr,action:qYr,deactivate:BYr,edit:VYr,active:HYr,inactive:KYr,rows_per_page:UYr,password:GYr,email:WYr,optional:JYr,renew_now:YYr,status:ZYr,in_progress:QYr,processed:XYr,processing_failed:eZr,participant_name:aZr,forms:tZr,completed:iZr,bulk_process_selected:nZr,download_selected:rZr,participant:oZr,e_learning:sZr,dive_pro:lZr,details:_Zr,view:dZr,reload:uZr,text_trouble_loading_data:cZr,sh