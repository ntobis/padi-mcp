ummary:g_i,renewal_year_2021:p_i,donate_to_project_aware:h_i,more_info:f_i,add_donation:v_i,auto_renewal_fee:y_i,tax:b_i,total:k_i,credit_card_type:w_i,secure_payment:P_i,name_on_card:S_i,card_number:A_i,expiration_date_mm_yy:C_i,cancel:z_i,first_payment:I_i,second_payment:D_i,donation:E_i,renewal_fee:j_i,save_my_changes:T_i,remove_donation:x_i,enroll_in_auto_renewal:R_i,please_enter_a_valid_amount:M_i,please_enter_a_valid_expiration_date:$_i,enter_a_valid_card_number:L_i,please_enter_name_on_card:O_i,draft:N_i,pending:F_i,resubmit:q_i,verified:B_i,\"2022_padi_member_renewal_pricing_will_be_published_in_fall_2021_youll_have_the_option_to_update_your_renewal_selection_after_pricing_is_published\":\"2022年度の更新料についてのご案内は2021年の秋に公開されます。更新するかどうかは、更新料が公開されてから決定することができます。\",file_size_limit:V_i,select_file:H_i,retry_upload:K_i,save:U_i,are_you_sure_you_want_to_delete_this_photo:G_i,delete_photo:W_i,edit_photo:J_i,completion_date:Y_i,reactivate_date:Z_i,padi_no:Q_i,instructor:X_i,address:edi,phone:adi,name:tdi,qualifications:idi,shop:ndi,savings:rdi,auto_renewal:odi,auto_renewal_payment_plan:sdi,one_time_renewal:ldi,add_new_user:_di,username:ddi,first_name:udi,last_name:cdi,role:mdi,action:gdi,deactivate:pdi,edit:hdi,active:fdi,inactive:vdi,rows_per_page:ydi,password:bdi,email:kdi,optional:wdi,renew_now:Pdi,status:Sdi,in_progress:Adi,processed:Cdi,processing_failed:zdi,participant_name:Idi,forms:Ddi,completed:Edi,bulk_process_selected:jdi,download_selected:Tdi,participant:xdi,e_learning:Rdi,dive_pro:Mdi,details:$di,view:Ldi,reload:Odi,text_trouble_loading_data:Ndi,showing_pagination_label:Fdi,program:qdi,from:Bdi,date:Vdi,signed:Hdi,complete:Kdi,all:Udi,new:\"新規\",empty_table_text:Gdi,limitations:Wdi,birth_date:Jdi,certification_card:Ydi,card_type:Zdi,card_back:Qdi,format:Xdi,padi_club_45_day_trial:eui,free_trial:aui,padi_club_membership_includes_exclusive_discounts_on_dive_courses_travel_an_annual_subscription_to_scuba_diving_magazine_and_more_if_you_are_in_the_us_provide_yo