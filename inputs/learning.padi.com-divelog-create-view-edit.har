          "postData": {
            "mimeType": "application/json",
            "text": "{\"query\":\" query logbook_logs($affiliate_id: Int!, $limit: Int, $offset: Int) {\\n  logbook_logs(\\n    where: {affiliate_id: {_eq: $affiliate_id}}\\n    order_by: {dive_date: desc, id: desc}\\n    limit: $limit\\n    offset: $offset\\n  ) {\\n    id\\n    log_type\\n    log_course\\n    log_number\\n    dive_title\\n    dive_date\\n    dive_location\\n    status\\n  }\\n}\",\"variables\":{\"affiliate_id\":\"14867369\",\"limit\":15,\"offset\":0}}"
          }
        },
