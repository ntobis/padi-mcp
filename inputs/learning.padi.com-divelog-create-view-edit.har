mitations:lMr,birth_date:_Mr,certification_card:dMr,card_type:uMr,card_back:cMr,format:mMr,padi_club_45_day_trial:gMr,free_trial:pMr,padi_club_membership_includes_exclusive_discounts_on_dive_courses_travel_an_annual_subscription_to_scuba_diving_magazine_and_more_if_you_are_in_the_us_provide_your_shipping_address_to_receive_your_paper_copy_of_the_magazine_customers_outside_the_us_will_receive_the_digital_version_please_note_padi_club_is_currently_available_in_english_only:hMr,membership_includes:fMr,\"20_off_select_padi_e_learning_courses\":\"ส่วนลด 20% สำหรับหลักสูตร PADI eLearning บางส่วน\",annual_subscription_to_scuba_diving_magazine:vMr,\"5_of_your_membership_fee_supports_ocean_conservation_efforts_around_the_globe\":\"5% ของค่าธรรมเนียมสมาชิกของคุณสนับสนุนความพยายามในการอนุรักษ์มหาสมุทรทั่วโลก\",free_reactivate_online_refresher:yMr,dan_prepared_diver_course:bMr,\"20_off_padi_merchandise\":\"ส่วนลด 20% สำหรับสินค้า PADI™\",member_credit_for_padi_travel:kMr,\"20_off_sea_life_i_phone_underwater_housing\":\"ส่วนลด 20% สำหรับเคส iPhone ใต้น้ำจาก SeaLife®\",try_it_for_free_for_45_days_at_the_end_of_the_trial_period_you_decide_whether_or_not_to_subscribe:wMr,promotional_code:PMr,apply:SMr,estimated_subtotal:AMr,item:CMr,items:zMr,promotion:IMr,estimated_tax:DMr,tax_calculated_at_checkout:EMr,project_aware_donation:jMr,shipping_handling:TMr,unfortunately_we_are_unable_to_place_orders_right_now_please_try_again_soon:xMr,continue_shopping:RMr,enter_coupon_code:MMr,payment_method:$Mr,credit_or_debit_card:LMr,expiration_date:OMr,of:NMr,activate:FMr,secure_checkout:qMr,cart_payment_methods_text:BMr,pay_in_installments:VMr,english:HMr,primary:KMr,work:UMr,mobile:GMr,no:WMr,jan:JMr,feb:YMr,mar:ZMr,apr:QMr,jun:XMr,jul:e$r,aug:a$r,sep:t$r,sept:i$r,oct:n$r,nov:r$r,dec:o$r,ok:s$r,submit:l$r,home:_$r,other:d$r,skip:u$r,back:c$r,certification:m$r,plan:g$r,member_number:p$r,search:h$r,store:f$r,account:v$r,certifications_credentials:y$r,no_ecard_found:b$r,you_dont_have_an_ecard_attac