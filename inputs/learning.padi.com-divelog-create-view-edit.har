venia:d5e,solomon_islands:u5e,somalia:c5e,south_africa:m5e,south_sudan:g5e,south_georgia_and_the_south_sandwich_islands:p5e,spain:h5e,sri_lanka:f5e,sudan:v5e,suriname:y5e,svalbard_and_jan_mayen:b5e,swaziland:k5e,sweden:w5e,switzerland:P5e,syrian_arab_republic:S5e,taiwan:A5e,tajikistan:C5e,tanzania_united_republic_of_tanzania:z5e,thailand:I5e,timor_leste:D5e,togo:E5e,tokelau:j5e,tonga:T5e,trinidad_and_tobago:x5e,tunisia:R5e,turkey:M5e,turkmenistan:$5e,turks_and_caicos_islands:L5e,tuvalu:O5e,uganda:N5e,ukraine:F5e,united_arab_emirates:q5e,united_kingdom:B5e,united_states:V5e,uruguay:H5e,uzbekistan:K5e,vanuatu:U5e,venezuela_bolivarian_republic_of_venezuela:G5e,vietnam:W5e,virgin_islands_british:J5e,virgin_islands_us:Y5e,wallis_and_futuna:Z5e,yemen:Q5e,zambia:X5e,zimbabwe:e6e,the_photo_exceeds_5mb_please_upload_a_photo_with_a_smaller_size:a6e,required:t6e,renewal_summary:i6e,renewal_year_2021:n6e,donate_to_project_aware:r6e,more_info:o6e,add_donation:s6e,auto_renewal_fee:l6e,tax:_6e,total:d6e,credit_card_type:u6e,secure_payment:c6e,name_on_card:m6e,card_number:g6e,expiration_date_mm_yy:p6e,cancel:h6e,first_payment:f6e,second_payment:v6e,donation:y6e,renewal_fee:b6e,save_my_changes:k6e,remove_donation:w6e,enroll_in_auto_renewal:P6e,please_enter_a_valid_amount:S6e,please_enter_a_valid_expiration_date:A6e,enter_a_valid_card_number:C6e,please_enter_name_on_card:z6e,draft:I6e,pending:D6e,resubmit:E6e,verified:j6e,\"2022_padi_member_renewal_pricing_will_be_published_in_fall_2021_youll_have_the_option_to_update_your_renewal_selection_after_pricing_is_published\":\"Die Verlängerungspreise für PADI-Mitglieder für 2022 werden im Herbst 2021 veröffentlicht. Du hast die Möglichkeit, deine Auswahl nach Veröffentlichung der Preise zu verändern.\",file_size_limit:T6e,select_file:x6e,retry_upload:R6e,save:M6e,are_you_sure_you_want_to_delete_this_photo:$6e,delete_photo:L6e,edit_photo:O6e,completion_date:N6e,reactivate_date:F6e,padi_no:q6e,instructor:B6e,address:V6e,phone:H6e,name:K6e,qu