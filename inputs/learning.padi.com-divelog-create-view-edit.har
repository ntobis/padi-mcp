MutationObserver(i=>{for(const n of i)if(n.type===\"childList\")for(const s of n.addedNodes)s.tagName===\"LINK\"&&s.rel===\"modulepreload\"&&a(s)}).observe(document,{childList:!0,subtree:!0});function o(i){const n={};return i.integrity&&(n.integrity=i.integrity),i.referrerPolicy&&(n.referrerPolicy=i.referrerPolicy),i.crossOrigin===\"use-credentials\"?n.credentials=\"include\":i.crossOrigin===\"anonymous\"?n.credentials=\"omit\":n.credentials=\"same-origin\",n}function a(i){if(i.ep)return;i.ep=!0;const n=o(i);fetch(i.href,n)}})();const rt=\"Welcome, \",ct=\"Tax\",lt=\"Total\",dt=\"Edit\",ut=\"Email\",mt=\"Phone\",pt=\"Cancel\",_t=\"Enter Mobile Phone Number\",ht=\"Thank you\",gt=\"English\",ft=\"Primary\",yt=\"Work\",bt=\"Mobile\",vt=\"Yes\",wt=\"No\",At=\"Jan\",Et=\"Feb\",Dt=\"Mar\",It=\"Apr\",Tt=\"Jun\",St=\"July\",Ct=\"Aug\",Pt=\"Sept\",kt=\"Sept\",$t=\"Oct\",Lt=\"Nov\",Rt=\"Dec\",Nt=\"OK\",Ot=\"Submit\",Ut=\"Home\",Mt=\"Other\",qt=\"Skip\",Ft=\"Back\",Gt=\"Certification\",Bt=\"Plan\",jt=\"Member Number\",Vt=\"Name\",xt=\"M.I. (Optional)\",Ht=\"Search\",Wt=\"Store\",zt=\"View\",Yt=\"Account\",Jt=\"Password\",Kt=\"Your email is used to login to your account and cannot be changed\",Qt=\"Old password\",Zt=\"Enter old password\",Xt=\"Incorrect password\",eo=\"New password\",to=\"Enter new password\",oo=\"Confirm Password\",ao=\"Enter confirm password\",no=\"Confirm password does not match new password\",io=\"Mobile Phone Number\",so=\"Enter a valid password\",ro=\"Password must contain at least 6 characters, including at least one upper and one lowercase letter.\",co=\"Certifications & Credentials\",lo=\"No eCard Found\",uo=\"You don't have an eCard attached to this certification\",mo=\"Replace my physical card\",po=\"Purchase eCard\",_o=\"STUDENT DETAILS\",ho=\"BIRTHDATE\",go=\"QUALIFICATION\",fo=\"Instructor\",yo=\"You've been unsubscribed.\",bo=\"Changes may take up to 24 hours to take effect.\",vo=\"We hate to see you go - prefer to stay?\",wo=\"Update or review your email preferences now.\",Ao=\"Update preferences\",Eo=\"Sign in or create an account\",Do=\"Visit padi.com\",Io=\"Oops\",To=\"Something went wrong.\",So=\"Refresh\",Co=\"Preferences\",Po=\"My information can be shared with PADI partners (e.g. Project AWARE) and 3rd parties affiliated with PADI.\",ko=\"See our privacy policy for details.\",$o=\"Save Preferences\",Lo=\"Thank you! Your preferences have been updated.\",Ro=\"There was an error saving.\",No=\"Email Language\",Oo=\"MANAGE YOUR EMAIL PREFERENCES\",Uo=\"Checked boxes indicate newsletters you wish to receive or have already subscribed\",Mo=\"Note: The following communications are required reading for all PADI Professional, Retail and Resort members (opt-out not available):\",qo=\"Surface Interval/Training Bulletin\",Fo=\"Quality Management Communications\",Go=\"Renewal Notifications (for current members)\",Bo=\"New Product Launches\",jo=\"Receive periodic announcements of new PADI products and relevant updates to programs\",Vo=\"Events & Member Forums\",xo=\"Reminders about online and offline PADI events, member forums, member socials, training seminars, and webinars\",Ho=\"Special Announcements from PADI CEO\",Wo=\"Hear directly from your PADI President and CEO about important topics related to your membership, the dive industry and our ocean planet.\",zo=\"PADI Publications\",Yo=\"PADI Travel\",Jo=\"Hear about special member-only offers from PADI Travel and learn about new destinations\",Ko=\"Special Promotions\",Qo=\"Receive periodic PADI sales promotions including special offers from PADI’s own ocean-first line of branded apparel and merchandise, PADI Pro Gear.\",Zo=\"Promotions from PADI Partners\",Xo=\"Hear from select PADI Partners a few times a month, including great deals on products, exclusive content and travel deals.\",ea=\"Settings\",ta=\"Language\",oa=\"Select a language\",aa=\"Units & Measurements\",na=\"Metric\",ia=\"Imperial\",sa=\"Profile\",ra=\"Your Name\",ca=\"First Name\",la=\"Enter first name\",da=\"Middle initial (optional)\",ua=\"Last name\",ma=\"Enter last name\",pa=\"Your Birthdate\",_a=\"Day\",ha=\"Enter your birthdate day\",ga=\"Month\",fa=\"Enter your birthdate month\",ya=\"Year\",ba=\"Enter your birthdate year\",va=\"Update\",wa=\"Your Gender\",Aa=\"Gender\",Ea=\"Male\",Da=\"Female\",Ia=\"Your Address\",Ta=\"Country\",Sa=\"Address\",Ca=\"Address 2\",Pa=\"City\",ka=\"State\",$a=\"Zip/Postal Code\",La=\"January\",Ra=\"February\",Na=\"March\",Oa=\"April\",Ua=\"May\",Ma=\"June\",qa=\"July\",Fa=\"August\",Ga=\"September\",Ba=\"October\",ja=\"November\",Va=\"December\",xa=\"Enter your address\",Ha=\"Enter your city/town\",Wa=\"Enter your postal code\",za=\"Enter your state\",Ya=\"State/Province\",Ja=\"Select Country/Region\",Ka=\"Remove\",Qa=\"Your Profile Photo\",Za=\"<strong>Note:</strong> Chosen language is only supported for select PADI messages at this time. In the event a message cannot be sent in your preferred language, a default language will be used.\",Xa=\"Certification card photo\",en=\"Upload a photo for your PADI certification card.\",tn=\"Upload photo\",on=\"Upload certification photo\",an=\"Select file\",nn=\"As positive identification cards, PADI certification card photos meet these requirements:\",sn=\"Full-face image of you\",rn=\"Face is clear, not obstructed\",cn=\"No dark glasses\",ln=\"No scuba masks\",dn=\"No hats\",un=\"4.5 MB (or smaller)\",mn=\"JPG or PNG format\",pn=\"Note: Only those photos that meet these parameters appear on PADI certification cards.\",_n=\"The photo exceeds 4.5MB. Please upload a photo with a smaller size.\",hn=\"Retry upload\",gn=\"This photo will appear on your certification card.\",fn=\"Save\",yn=\"Cancel\",bn=\"Certification photo received. Thank you. If this photo doesn't work for your card, we will let you know.\",vn=\"Replace photo\",wn=\"Confirm Shop\",An=\"Confirm Instructor\",En=\"Please confirm that the PADI professional member listed below is the one you will be taking your in water portion of your experience with.\",Dn=\"Please confirm that the PADI professional member listed below is the one you will be taking your in water portion of your experience with.\",In=\"Not correct?\",Tn=\"Change Shop\",Sn=\"I agree to share my account information and my program results with {name}\",Cn=\"Confirm Member\",Pn=\"Next\",kn=\"Try Again\",$n=\"There is a beautiful, unique world of life to discover underwater. If you have always wanted to try an adventure in the undersea world, the Discover Scuba Diving course is an easy way to take your first trip there. While not a scuba certification course, Discover Scuba Diving is an easy introduction to what it takes to explore the underwater world.\",Ln=\"Your underwater experience along with the key skills you’ll learn in Discover Scuba Diving will give you the building blocks you need to become a PADI Open Water certified diver.\",Rn=\"For your safety and well-being while diving, please follow all instructions as you complete the form, answering completely and honestly. Make sure you double-check your responses before submitting the form; you won’t be able to edit your responses after you submit it. Note that if you need further evaluation, it does not necessarily mean you can't dive, it means you need to consult with your physician before proceeding. Parents need to fill out the Questionnaire for their minor children.\",Nn=\"Print/Save\",On=\"Forms\",Un=\"Privacy Policy\",Mn=\"Consumer Protection\",qn=\"Contact\",Fn=\"Sign In\",Gn=\"Sign Out\",Bn=\"Logbook\",jn=\"All your dives in one place.\",Vn=\"Getting started\",xn=\"When you start to log dives during your diving journey, they will appear here.\",Hn=\"Log training dive\",Wn=\"Log recreational dive\",zn=\"Pending\",Yn=\"Resubmit\",Jn=\"ft\",Kn=\"feet\",Qn=\"minutes\",Zn=\"min\",Xn=\"All\",ei=\"Training\",ti=\"Recreational\",oi=\"Drafts\",ai=\"Draft\",ni=\"General\",ii=\"Dive Title\",si=\"Dive Site\",ri=\"Date\",ci=\"Type of Dive\",li=\"What do you want to call your dive?\",di=\"Where did you dive?\",ui=\"What was the date of your dive?\",mi=\"What's your instructor's PADI number?\",pi=\"How did you get in the water?\",_i=\"Add\",hi=\"PADI Number\",gi=\"Shore\",fi=\"Boat\",yi=\"Depth/Time\",bi=\"Time in\",vi=\"Time Out\",wi=\"Max Depth\",Ai=\"Bottom Time\",Ei=\"How deep did you go?\",Di=\"How long was your dive?\",Ii=\"Training Dive Skills\",Ti=\"Skills\",Si=\"Flexible\",Ci=\"Flexible Skills\",Pi=\"Your instructor will determine when you will conduct these skills, depending on dive logistics and conditions.\",ki=\"No flexible skills completed on this dive\",$i=\"Cramp removal\",Li=\"Tired diver tow\",Ri=\"Inflatable signal tube/DSMB deployment\",Ni=\"Emergency weight drop (or in CW)\",Oi=\"Snorkel/regulator exchange\",Ui=\"Remove/replace scuba (surface)\",Mi=\"Remove/replace weights (surface)\",qi=\"Surface swim with compass\",Fi=\"Underwater compass navigation (Dive 2, 3, or 4)\",Gi=\"Controlled Emergency Swimming Ascent (Dive 2, 3, or 4)\",Bi=\"Hand signal recognition\",ji=\"Equipment preparation, donning and adjustment\",Vi=\"Predive safety check\",xi=\"Entry\",Hi=\"Buoyancy/weight check\",Wi=\"Controlled descent\",zi=\"Trim check\",Yi=\"Partial mask flood\",Ji=\"Regulator recovery/clear\",Ki=\"Underwater exploration\",Qi=\"Signal air supply\",Zi=\"Stay close to buddy\",Xi=\"Ascent\",es=\"Exit\",ts=\"Plan dive\",os=\"Entry and weight check\",as=\"Signal turn point\",ns=\"Orally inflate BCD (surface)\",is=\"Descent\",ss=\"Buoyancy control\",rs=\"Fully flooded mask clearing \",cs=\"Alternate air source use/ascent\",ls=\"Avoid contact\",ds=\"Free descent with visual reference\",us=\"Mask remove/replace\",ms=\"Water Type\",ps=\"Body of Water\",_s=\"Weather\",hs=\"Temperature\",gs=\"Air Temperature\",fs=\"Surface Temperature\",ys=\"Bottom Temperature\",bs=\"Visibility\",vs=\"Waves\",ws=\"Current\",As=\"Surge\",Es=\"What type of water was it?\",Ds=\"What body of water did you dive in?\",Is=\"How was the weather?\",Ts=\"How was the temp?\",Ss=\"What was the air temp?\",Cs=\"What was the surface temp?\",Ps=\"What was the bottom temp?\",ks=\"How was the visibility?\",$s=\"How far could you see?\",Ls=\"How were the waves?\",Rs=\"How was the current?\",Ns=\"How was the surge?\",Os=\"Salt\",Us=\"Ocean\",Ms=\"Sunny\",qs=\"°F\",Fs=\"°C\",Gs=\"High\",Bs=\"None\",js=\"Light\",Vs=\"Fresh\",xs=\"Lake\",Hs=\"Partly Cloudy\",Ws=\"Average\",zs=\"Small\",Ys=\"Low\",Js=\"Medium\",Ks=\"River\",Qs=\"Rainy\",Zs=\"Large\",Xs=\"Strong\",er=\"Windy\",tr=\"Foggy\",or=\"Equipment\",ar=\"Suit\",nr=\"Weight\",ir=\"Additional Gear\",sr=\"Cylinder\",rr=\"Gas Mixture\",cr=\"Cylinder Pressure\",lr=\"Starting Pressure\",dr=\"Ending Pressure\",ur=\"Amount Used\",mr=\"What suit did you wear?\",pr=\"How was the amount of weight you used?\",_r=\"What other gear did you wear?\",hr=\"What kind of cylinder did you use?\",gr=\"What was the cylinder size?\",fr=\"Air\",yr=\"PSI\",br=\"How much did you start with?\",vr=\"How much was remaining?\",wr=\"This will be auto calculated.\",Ar=\"lbs\",Er=\"Hood\",Dr=\"Steel\",Ir=\"cu ft\",Tr=\"Liters\",Sr=\"EANx32\",Cr=\"bar\",Pr=\"Full Suit 3mm\",kr=\"Gloves\",$r=\"Aluminum\",Lr=\"EANx36\",Rr=\"Full Suit 5mm\",Nr=\"Good\",Or=\"Boots\",Ur=\"EANx40\",Mr=\"Full Suit 7mm\",qr=\"Heavy\",Fr=\"Enriched\",Gr=\"Shorty\",Br=\"Trimix\",jr=\"Semi Dry\",Vr=\"Dry Suit\",xr=\"Rebreather\",Hr=\"Oxygen\",Wr=\"Nitrogen\",zr=\"Helium\",Yr=\"Experience\",Jr=\"Feeling\",Kr=\"Note\",Qr=\"Buddy\",Zr=\"Dive Center\",Xr=\"How did you feel about this dive?\",ec=\"Write down the memories of your dive\",tc=\"Who did you go with?\",oc=\"What dive center did you dive with?\",ac=\"Amazing\",nc=\"Poor\",ic=\"Success!\",sc=\"Uh Oh!\",rc=\"You have successfully submitted your logged training dive to your instructor. Check your logbook soon for the status.\",cc=\"An error occurred, and we were unable to publish this dive log.\",lc=\"In the meantime, add additional details to your logged dive before you forget them. This is optional and you can come back and do it any time.\",dc=\"Go to Logbook\",uc=\"Log Dive\",mc=\"Save to Drafts\",pc=\"Submit for Verification\",_c=\"Select course and training dive number\",hc=\"Select Training Dive\",gc=\"Open Water Diver\",fc=\"Open Water Training Dive 1\",yc=\"Open Water Training Dive 2\",bc=\"Open Water Training Dive 3\",vc=\"Open Water Training Dive 4\",wc=\"You have logged all training dives for this course.\",Ac=\"View all courses\",Ec=\"Enter a title\",Dc=\"Enter a location\",Ic=\"Enter a date\",Tc=\"Select a dive type\",Sc=\"Enter an instructor\",Cc=\"Invalid Instructor Number\",Pc=\"Required fields missing in:\",kc=\"General and Depth/Time\",$c=\"General and Training Dive Skills\",Lc=\"Depth/Time and Training Dive Skills\",Rc=\"General, Depth/Time and Training Dive Skills\",Nc=\"Enter a max depth\",Oc=\"Enter a bottom time\",Uc=\"Buoyancy control/Oral inflation\",Mc=\"Plan dive using slate\",qc=\"Free descent without reference\",Fc=\"Safety stop\",Gc=\"Select at least 1 skill\",Bc=\"Are you ready to send to\",jc=\"m\",Vc=\"Quarry\",xc=\"Cloudy\",Hc=\"What kind of gas did you use?\",Wc=\"Total Dives\",zc=\"Dive Time\",Yc=\"Conditions\",Jc=\"kg\",Kc=\"Continue Logging\",Qc=\"Instructor Submission\",Zc=\"Loading your logged dives\",Xc=\"Photos\",el=\"What did you see during your dive?\",tl=\"JPG, PNG (10MB maximum per photo)\",ol=\"Assembling and Positioning Emergency Equipment\",al=\"Describe and Record Color Changes at Depth\",nl=\"Dive Computer/Depth Gauge Comparisons\",il=\"Compass Use on Land\",sl=\"Distance Swim\",rl=\"Time Estimation Swim\",cl=\"Navigate a Straight Line and its Reciprocal Using Natural Navigation\",ll=\"Navigate a Straight Line and its Reciprocal Using a Compass\",dl=\"Navigate a Square Pattern Using a Compass\",ul=\"Boat Diving Entry\",ml=\"Navigate From and Back to Boat\",pl=\"Deploy Surface Marker Buoy\",_l=\"Boat Diving Exit\",hl=\"Stow Equipment\",gl=\"Camera System Setup\",fl=\"Still and Video Imaging\",yl=\"Drift Dive\",bl=\"Buoyancy Check with Dry Suit\",vl=\"Neutral Buoyancy\",wl=\"Dry Suit Dive\",Al=\"Scuba Unit and Weight System Remove and Replacement at Surface\",El=\"Slate Preparation\",Dl=\"Observe and Identify Fish Families\",Il=\"Record Sightings\",Tl=\"Sketch/Describe Unfamiliar Fish\",Sl=\"Demonstrate Environmentally Friendly Diving Practices\",Cl=\"Use Reference Materials to Identify Unfamiliar Fish\",Pl=\"Effective Communication and Light Use\",kl=\"Navigation\",$l=\"Guided Tour\",Ll=\"Buoyancy Check\",Rl=\"Neutral Buoyancy During Descent\",Nl=\"Hovering\",Ol=\"Fine-tune with Breath Control\",Ul=\"Practice Search Patterns on Land\",Ml=\"Practice Object Rigging on Land\",ql=\"Small Area Search\",Fl=\"Large Area Search\",Gl=\"Tie Knots Underwater\",Bl=\"Rigging and Lifting an Object\",jl=\"Identify Aquatic Plant Life\",Vl=\"Identify and Observe Aquatic Invertebrates\",xl=\"Identify and Observe Aquatic Vertebrates\",Hl=\"Log\",Wl=\"Knowledge Review\",zl=\"Briefing, Tasks and Planning\",Yl=\"Suiting Up\",Jl=\"Predive Safety Check (BWRAF)\",Kl=\"Navigating the Wreck\",Ql=\"Returning to Ascent Point\",Zl=\"Ascent – Safety Stop\",Xl=\"Debrief: Self-critique and Performance Assessment\",ed=\"Log Dive – Complete Training Record\",td=\"Adventure Dive Type\",od=\"What adventure dive did you complete?\",ad=\"Select Adventure Dive\",nd=\"Save\",id=\"Dive Type\",sd=\"Training Dive\",rd=\"Select Course\",cd=\"Save \",ld=\"Dive\",dd=\"Scenario 1 - Unresponsive Diver Underwater\",ud=\"Search for and locate a missing diver during an accident simulation. Demonstrate:\",md=\"2. Organizing a quick and effective search (using surface and underwater search patterns).\",pd=\"4. Bringing a diver simulating unresponsiveness to the surface using controlled positive buoyancy.\",_d=\"Scenario 2 - Unresponsive Diver at the Surface\",hd=\"Demonstrate:\",gd=\"2. Evaluation, tow, inwater rescue breathing, removing equipment, exiting and providing CPR.\",fd=\"Note: Either use a CPR mannequin or simulate compressions for CPR.\",yd=\"Exercise 1: Tired Diver\",bd=\"Exercise 2: Panicked Diver\",vd=\"Exercise 3: Response from Shore, Boat or Dock (Responsive Diver)\",wd=\"Exercise 4: Distressed Diver Underwater\",Ad=\"Exercise 5: Missing Diver\",Ed=\"Exercise 6: Surfacing the Unresponsive Diver\",Dd=\"Exercise 7: Unresponsive Diver at the Surface\",Id=\"Exercise 8: Exiting the Unresponsive Diver\",Td=\"Exercise 9: First Aid for Pressure-related Injuries and Oxygen Administration\",Sd=\"Exercise 10: Response from Shore/Boat (Unresponsive Diver)\",Cd=\"Notifications\",Pd=\"Today\",kd=\"Yesterday\",$d=\"Older\",Ld=\"Mark all as read\",Rd=\"Recreational Diving and Dive Travel Inspiration\",Nd=\"Dive excursions, dream destinations, inspiring adventures, and top offers on dive travel\",Od=\"Eco-Friendly Shopping\",Ud=\"Information and offers on diver & ocean friendly clothing and accessories\",Md=\"Dive Education\",qd=\"The latest on dive courses and training\",Fd=\"Ocean Conservation\",Gd=\"Stay up to date on the latest in protecting our diving environment\",Bd=\"PADI News and Updates\",jd=\"Keep me informed on the latest information, news and special offers about the world of diving and underwater exploration (uncheck to be removed from all PADI marketing communications)\",Vd=\"Partner\",xd=\"Get your quarterly Undersea Journal digital magazine (available worldwide) and each issue of Scuba Diving magazine (PADI Americas only)\",Hd=\"Dashboard\",Wd=\"Support\",zd=\"Performance\",Yd=\"My Courses\",Jd=\"Preferences\",Kd=\"Tools\",Qd=\"PADI Pro\",Zd=\"My Profile\",Xd=\"Shop\",eu=\"Diver Tools\",tu=\"Shop Home\",ou=\"PADI Club\",au=\"Discover Scuba Diving\",nu=\"Next - Physician's Evaluation Form Required\",iu=\"Based on your responses in the Diver Medical Form, a Physician Evaluation is needed. \",su=\"Please print the Diver Medical Form with your answers and take it along with the following Physician's Evaluation form to a physician for medical evaluation. Participation in this diving program requires your physician's approval.\",ru=\"Your forms have been submitted to your Dive Professional. You can view your forms and download them at any time and download them within your browser.\",cu=\"View Forms\",lu=\"Continue to Program\",du=\"Or\",uu=\"And\",mu=\"Diver Medical Participant Questionnaire\",pu=\"I have/had problems with my lungs, breathing, heart and/or blood affecting my normal physical or mental performance.\",_u=\"Recreational scuba diving and freediving requires good physical and mental health. There are a few medical conditions which can be hazardous while diving, listed below. Those who have, or are predisposed to, any of these conditions, should be evaluated by a physician.\",hu=\"This Diver Medical Participant Questionnaire provides a basis to determine if you should seek out that evaluation. If you have any concerns about your diving fitness not represented on this form, consult with your physician before diving. If you are feeling ill, avoid diving. If you think you may have a contagious disease, protect yourself and others by not participating in dive training and/or dive activities. References to “diving” on this form encompass both recreational scuba diving and freediving.\",gu=\"This form is principally designed as an initial medical screen for new divers, but is also appropriate for divers taking continuing education.\",fu=\"For your safety, and that of others who may dive with you, answer all questions honestly.\",yu=\"Directions\",bu=\"Complete this questionnaire as a prerequisite to a recreational scuba diving or freediving course.\",vu=\"Note to women: \",wu=\"If you are pregnant, or attempting to become pregnant, \",Au=\"do not dive.\",Eu=\"I am over 45 years of age.\",Du=\"I struggle to perform moderate exercise (for example, walk 1.6 kilometer/one mile in 14 minutes or swim 200 meters/yards without resting), OR I have been unable to participate in a normal physical activity due to fitness or health reasons within the past 12 months.\",Iu=\"I have had problems with my eyes, ears, or nasal passages/sinuses.\",Tu=\"I have had surgery within the last 12 months, OR I have ongoing problems related to past surgery.\",Su=\"I have lost consciousness, had migraine headaches, seizures, stroke, significant head injury, or suffer from persistent neurologic injury or disease.\",Cu=\"I am currently undergoing treatment (or have required treatment within the last five years) for psychological problems, personality disorder, panic attacks, or an addiction to drugs or alcohol; or, I have been diagnosed with a learning or developmental disability.\",Pu=\"I have had back problems, hernia, ulcers, or diabetes.\",ku=\"I have had stomach or intestine problems, including recent diarrhea.\",$u=\"I am taking prescription medications (with the exception of birth control or anti-malarial drugs other than mefloquine (Lariam).\",Lu=\"If you answered \",Ru=\" to all 10 primary questions above, a medical evaluation is not required. Please read and agree to the participant statement below by signing and dating it.\",Nu=\"\",Ou=\"\",Uu=\" to questions 3, 5 or 10 above \",Mu=\"\",qu=\"to any of the secondary questions, please read and agree to the statement above by signing and dating it \",Fu=\"take all pages of this form and the Physician’s Evaluation Form to your physician\",Gu=\"for a medical evaluation. Participation in a diving course requires your physician’s approval.\",Bu=\" I have answered all questions honestly, and understand that I accept responsibility for any consequences resulting from any questions I may have answered inaccurately or for my failure to disclose any existing or past health conditions.\",ju=\"Non-Agency Disclosure and Acknowledgment Agreement\",Vu=\"I understand and agree that PADI Members (“Members”), including {memberOrShopName} and/or any individual PADI Instructors and Divemasters associated with the program in which I am participating, are licensed to use various PADI Trademarks and to conduct PADI training, but are not agents, employees or franchisees of PADI Americas, Inc, or its parent, subsidiary and affiliated corporations (“PADI”). I further understand that Member business activities are independent, and are neither owned nor operated by PADI, and that while PADI establishes the standards for PADI diver training programs, it is not responsible for, nor does it have the right to control, the operation of the Members’ business activities and the day-to-day conduct of PADI programs and supervision of divers by the Members or their associated staff. I further understand and agree on behalf of myself, my heirs and my estate that in the event of an injury or death during this activity, neither I nor my estate shall seek to hold PADI liable for the actions, inactions or negligence of {memberOrShopName} and/or the instructors and divemasters associated with the activity.\",xu=\"Liability Release and Assumption of Risk Agreement\",Hu=\"I, {participantName}, hereby affirm that I am aware that skin and scuba diving have inherent risks which may result in serious injury or death. I understand that diving with compressed air involves certain inherent risks; including but not limited to decompression sickness, embolism or other hyperbaric/air expansion injury that require treatment in a recompression chamber. I further understand that the open water diving trips which are necessary for training and for certification may be conducted at a site that is remote, either by time or distance or both, from such a recompression chamber. I still choose to proceed with such instructional dives in spite of the possible absence of a recompression chamber in proximity to the dive site. I understand and agree that neither my instructor(s), {instructorOrStaffName}, the facility through which I receive my instruction, {shopNameOrNA} nor PADI Americas, Inc., nor its affiliate and subsidiary corporations, nor any of their respective employees, officers, agents, contractors or assigns (hereinafter referred to as “Released Parties”) may be held liable or responsible in any way for any injury, death or other damages to me, my family, estate, heirs or assigns that may occur as a result of my participation in this diving program or as a result of the negligence of any party, including the Released Parties, whether passive or active. In consideration of being allowed to participate in this course (and optional Adventure Dive), hereinafter referred to as “program,” I hereby personally assume all risks of this program, whether foreseen or unforeseen, that may befall me while I am a participant in this program including, but not limited to, the academics, confined water and/or open water activities. I further release, exempt and hold harmless said program and Released Parties from any claim or lawsuit by me, my family, estate, heirs or assigns, arising out of my enrollment and participation in this program including both claims arising during the program or after I receive my certification. I also understand that skin diving and scuba diving are physically strenuous activities and that I will be exerting myself during this program, and that if I am injured as a result of heart attack, panic, hyperventilation, drowning or any other cause, that I expressly assume the risk of said injuries and that I will not hold the Released Parties responsible for the same. I further state that I am of lawful age and legally competent to sign this liability release, or that I have acquired the written consent of my parent or guardian. I understand the terms herein are contractual and not a mere recital, and that I have signed this Agreement of my own free act and with the knowledge that I hereby agree to waive my legal rights. I further agree that if any provision of this Agreement is found to be unenforceable or invalid, that provision shall be severed from this Agreement. The remainder of this Agreement will then be construed as though the unenforceable provision had never been contained herein. I understand and agree that I am not only giving up my right to sue the Released Parties but also any rights my heirs, assigns, or beneficiaries may have to sue the Released Parties resulting from my death. I further represent I have the authority to do so and that my heirs, assigns, or beneficiaries will be estopped from claiming otherwise because of my representations to the Released Parties.\",Wu=\"I, {participantName}, BY THIS INSTRUMENT AGREE TO EXEMPT AND RELEASE MY INSTRUCTORS, {instructorOrStaffName}, THE FACILITY THROUGH WHICH I RECEIVE MY INSTRUCTION, {shopNameOrNA}AND PADI AMERICAS, INC., AND ALL RELATED ENTITIES AS DEFINED ABOVE, FROM ALL LIABILITY OR RESPONSIBILITY WHATSOEVER FOR PERSONAL INJURY, PROPERTY DAMAGE OR WRONGFUL DEATH HOWEVER CAUSED, INCLUDING, BUT NOT LIMITED TO, THE NEGLIGENCE OF THE RELEASED PARTIES, WHETHER PASSIVE OR ACTIVE.\",zu=\"I HAVE FULLY INFORMED MYSELF AND MY HEIRS OF THE CONTENTS OF THIS NON-AGENCY DISCLOSURE AND ACKNOWLEDGEMENT AGREEMENT AND LIABILITY RELEASE AND ASSUMPTION OF RISK AGREEMENT BY READING BOTH BEFORE SIGNING BELOW ON BEHALF OF MYSELF AND MY HEIRS.\",Yu=\"Participant Name\",Ju=\"Participant Birthday\",Ku=\"Instructor / Facility Name\",Qu=\"Signature (or, if a minor, parent/guardian signature required)\",Zu=\"Draw your signature\",Xu=\"Type your signature\",em=\"Signature\",tm=\"I understand this is my signature\",om=\"I have/had chest surgery, heart surgery, heart valve surgery, an implantable medical device (eg, stent, pacemaker, neurostimulator), pneumothorax and/or chronic lung disease.\",am=\"I have/had asthma, wheezing, severe allergies, hay fever or congested airways within the last 12 months that limits my physical activity/exercise.\",nm=\"I have/had a problem or illness involving my heart such as: angina, chest pain on exertion, heart failure, immersion pulmonary edema, heart attack or stroke, OR am taking medication for any heart condition.\",im=\"I have/had recurrent bronchitis and currently coughing within the past 12 months, OR have been diagnosed with emphysema.\",sm=\"I have/had symptoms affecting my lungs, breathing, heart and/or blood in the last 30 days that impair my physical or mental performance.\",rm=\"I currently smoke or inhale nicotine by other means.\",cm=\"I have a high cholesterol level.\",lm=\"I have high blood pressure.\",dm=\"I have had a close blood relative die suddenly or of cardiac disease or stroke before the age of 50, OR have a family history of heart disease before age 50 (including abnormal heart rhythms, coronary artery disease or cardiomyopathy).\",um=\"Sinus surgery within the last 6 months\",mm=\"Ear disease or ear surgery, hearing loss, or problems with balance.\",pm=\"Recurrent sinusitis within the past 12 months.\",_m=\"Eye surgery within the past 3 months.\",hm=\"Head injury with loss of consciousness within the past 5 years.\",gm=\"Persistent neurologic injury or disease.\",fm=\"Recurring migraine headaches within the past 12 months, or take medications to prevent them.\",ym=\"Blackouts or fainting (full/partial loss of consciousness) within the last 5 years.\",bm=\"Epilepsy, seizures, or convulsions, OR take medications to prevent them.\",vm=\"Behavioral health, mental or psychological problems requiring medical/psychiatric treatment.\",wm=\"Major depression, suicidal ideation, panic attacks, uncontrolled bipolar disorder requiring medication/psychiatric treatment.\",Am=\"Been diagnosed with a mental health condition or a learning/developmental disorder that requires ongoing care or special accommodation.\",Em=\"An addiction to drugs or alcohol requiring treatment within the last 5 years.\",Dm=\"Recurrent back problems in the last 6 months that limit my everyday activity.\",Im=\"Back or spinal surgery within the last 12 months.\",Tm=\"Diabetes, either drug- or diet-controlled, OR gestational diabetes within the last 12 months.\",Sm=\"An uncorrected hernia that limits my physical abilities.\",Cm=\"Active or untreated ulcers, problem wounds, or ulcer surgery within the last 6 months.\",Pm=\"Ostomy surgery and do not have medical clearance to swim or engage in physical activity.\",km=\"Dehydration requiring medical intervention within the last 7 days.\",$m=\"Active or untreated stomach or intestinal ulcers or ulcer surgery within the last 6 months.\",Lm=\"Frequent heartburn, regurgitation, or gastroesophageal reflux disease (GERD).\",Rm=\"Active or uncontrolled ulcerative colitis or Crohn’s disease.\",Nm=\"Bariatric surgery within the last 12 months.\",Om=\"Full Name\",Um=\"Submit Form\",Mm=\"Staff of\",qm=\"Health and Diving\",Fm=\"Medical Declaration for Resort Diving\",Gm=\"Office of Industrial Relations - Workplace Health and Safety Queensland\",Bm=\"To be completed and signed by resort diver\",jm=\"Completing this form is required under section 7 of the Safety in Recreational Water Activities Regulation 2011 before a person can do resort diving.\",Vm=\"Personal details\",xm=\"Surname\",Hm=\"Given names\",Wm=\"Country/Region\",zm=\"Select Country/Region\",Ym=\"Address Line 2\",Jm=\"Select State/Province\",Km=\"Diver Medical\",Qm=\"Physician's Evaluation Form\",Zm=\"Birthday\",Xm=\"Print\",ep=\"Date (dd/mm/yyyy)\",tp=\"The above-named person requests your opinion of his/her medical suitability to participate in recreational scuba diving or freediving training or activity. Please visit\",op=\" for medical guidance on medical conditions as they relate to diving. Review the areas relevant to your patient as part of your evaluation.\",ap=\"Evaluation Result\",np=\"Approved – I find no conditions that I consider incompatible with recreational scuba diving or freediving.\",ip=\"Not approved – I find conditions that I consider incompatible with recreational scuba diving or freediving.\",sp=\"Physician‘s Signature\",rp=\"Physician‘s Name\",cp=\"Specialty\",lp=\"Clinic/Hospital Address\",dp=\"Date of birth\",up=\"Witness\",mp=\"Have you suffered, or do you now suffer from, any of the following\",pp=\"Asthma or wheezing\",_p=\"Brain, spinal cord or nervous disorder\",hp=\"Chest surgery\",gp=\"Chronic bronchitis or persistent chest complaint\",fp=\"Chronic sinus conditions\",yp=\"Collapsed lung (pneumothorax)\",bp=\"Diabetes mellitus (sugar diabetes)\",vp=\"Ear surgery\",wp=\"Epilepsy\",Ap=\"Fainting, seizures or blackouts\",Ep=\"Heart disease of any kind\",Dp=\"Recurrent ear problems when flying\",Ip=\"Tuberculosis or other long-term lung disease\",Tp=\"Are you currently suffering from:\",Sp=\"Breathlessness\",Cp=\"Chronic ear discharge or infection\",Pp=\"High blood pressure\",kp=\"Other illness or operation within the last month\",$p=\"Perforated eardrum\",Lp=\"Are you currently taking any medicine or drug (excluding oral contraceptives)?\",Rp=\"Have you ingested any alcohol within the 8 hours prior to diving?\",Np=\"Are you pregnant?\",Op=\"I understand that concealment of any condition incompatible with safe diving may put my life or health at risk.\",Up=\"If you do not wish to confirm your understanding of the above statement, please speak with your Dive Instructor before proceeding.\",Mp=\"Physician/Clinic Stamp (optional)\",qp=\"Created by the \",Fp=\"in association with the following bodies:\",Gp=\"Diver Medical Screen Committee\",Bp=\"The Undersea & Hyperbaric Medical Society\",jp=\"DAN (US)\",Vp=\"DAN Europe\",xp=\"Hyperbaric Medicine Division, University of California, San Diego\",Hp=\"Statement of Risk and Liability/ Non-agency Acknowledgment Form - General Training\",Wp=\"EU Version\",zp=\"Please read carefully and fill in all blanks before signing\",Yp='I understand and agree that PADI Members (\"Members\"), including {memberOrShopName} and/or any individual PADI Instructors and Divemasters associated with the program in which I am participating, are licensed to use various PADI Trademarks and to conduct PADI training, but are not agents, employees or franchisees of PADI EMEA Ltd., PADI Americas, Inc., or its parent, subsidiary and affiliated corporations (\"PADI\"). I further understand that Member business activities are independent, and are neither owned nor operated by PADI, and that while PADI establishes the standards for PADI diver training programs, it is not responsible for, nor does it have the right to control, the operation of the Members\\' business activities and the day-to-day conduct of PADI programs and supervision of divers by the Members or their associated staff.',Jp=\"Statement of Risk and Liability\",Kp=\"This is a statement in which you are informed of the risks of skin and scuba diving. The statement also sets out the circumstances in which you participate in the diving programme at your own risk. Your signature on this statement is required as proof that you have received and read this statement. It is important that you read the contents of this statement before signing it. If you do not understand anything contained in this statement, then please discuss it with your instructor. If you are a minor, this form must also be signed by a parent or guardian. <br /><br /> <strong>Warning:</strong> Skin and scuba diving have inherent risks which may result in serious injury or death. <br /><br /> Diving with compressed air involves certain inherent risks; decompression sickness, embolism or other hyperbaric injury can occur that require treatment in a recompression chamber. Open water diving trips that are necessary for training and for certification, may be conducted at a site that is remote, either by time or distance or both, from such a recompression chamber. Skin and scuba diving are physically strenuous activities and you will be exerting yourself during this diving programme. You must advise truthfully and fully inform the dive professionals and the facility through which this programme is offered of your medical history.\",Qp=\"Acceptance of Risk\",Zp=\"I understand and agree that neither the dive professionals conducting this programme, {instructorOrStaffName}, nor the facility through which this programme is conducted, {shopNameOrNA}nor PADI EMEA Ltd., nor PADI Americas, Inc. nor their affiliate or subsidiary corporations, nor any of their respective employees, officers, agents, contractors or assigns accept any responsibility for any death, injury or other loss suffered by me to the extent that it result from my own conduct or any matter or condition under my control that amounts to my own contributory negligence. In the absence of any negligence or other breach of duty by the dive professionals conducting this programme, {instructorOrStaffName}the facility through which this programme is offered, {shopNameOrNA}PADI EMEA Ltd., PADI Americas, Inc. and all parties referred to above, my participation in this diving programme is entirely at my own risk.\",Xp=\"I HAVE FULLY INFORMED MYSELF OF THE CONTENTS OF THIS NON-AGENCY DISCLOSURE AND ACKNOWLEDGMENT AGREEMENT AND STATEMENT OF RISK AND LIABILITY BY READING BOTH BEFORE SIGNING THESE STATEMENTS.\",e_=\"Rev\",t_=\"Version\",o_=\"Signature of Parent or Guardian (where applicable)\",a_=\"Participant Signature\",n_=\" & Instructors\",i_=\"You are unable to begin your Discover Scuba Diving Program at this time.  Contact your PADI Member to resolve this issue.  Once your PADI Member has confirmed the issue has been resolved, select the Try Again button below.\",s_=\"We are preparing learning materials for you. This could take up to 4 minutes.\",r_=\"We were unable to create your eLearning.  Please contact <a href='{contactUrl}'>your local PADI Office</a> for assistance.\",c_=\"Welcome to the PADI Family!\",l_=\"Exclusive offer for you\",d_=\"Congratulations on successfully completing your PADI Discover Scuba Diving Program! You are now one step closer to becoming a certified Open Water Diver.\",u_=\"Access your Discover Scuba Diving eCard\",m_=\"You can access your DSD eCard at anytime in the PADI App or by logging in to padi.com\",p_=\"Join PADI Club\",__=\"The world's largest dive membership program, inspiring adventure and connection to the ocean through pure and vivid content, exclusive privileges, and insider access to savings.\",h_=\"Go to Club\",g_=\"Wear PADI Gear\",f_=\"Apparel, diving accessories and eco-friendly products for people who love scuba diving, snorkeling or freediving.\",y_=\"Go to Gear\",b_=\"Dive in with PADI Travel\",v_=\"Become a Diver\",w_=\"*You can then take the course at any time you want in the future with the dive center of your choice\",A_=\"Access eCard\",E_=\"Go to Travel\",D_=\"Meet PADI Ambassadivers\",I_=\"Meet the passionate aquatic ambassadors committed to lighting the way for more people to follow their dreams to explore, protect and experience the underwater world.\",T_=\"Go to Ambassadivers\",S_=\"Book a vacation at a PADI Dive Resort and combine it with the Open Water Course to become a certified diver.\",C_=\"Select Shop\",P_=\"Exclusive limited time offer (valid until {validDate}): purchase eLearning for the Open Water Diver course now and get 20% off*. As a PADI Open Water Diver, you'll be trained to a maximum depth of 18 metres/60 feet, and are qualified to dive in conditions as good as, or better than, those in which you trained. It's just the beginning of a lifetime filled with dive adventures.\",k_=\"eCards\",$_=\"Tap any card to view details\",L_=\"You don’t have any eCards attached to your account at this time.\",R_=\"Buy Cert. Card\",N_=\"No PADI Program Found\",O_=\"Take the plunge with one of our entry level programs for scuba diving, freediving or mermaid. If you think this is a mistake, please contact our Customer Relations Team.\",U_=\"Learn More\",M_=\"Contact Us\",q_=\"Check out our entry level courses\",F_=\"Sort By\",G_=\"Name(A - Z)\",B_=\"Name(Z - A)\",j_=\"Most Popular\",V_=\"Price: Low to High\",x_=\"Price: High to Low\",H_=\"Certifications with no eCards\",W_=\"No Certifications Found\",z_=\"No additional Certifications without eCards.\",Y_=\"View All\",J_=\"All eCards\",K_=\"Assisted equipment preparation, donning and adjustment\",Q_=\"Breathing and equalization techniques\",Z_=\"courses\",X_=\"Total Dive time\",eh=\"Location\",th=\"Dive Date\",oh=\"Prefer not to Say\",ah=\"Male / Man\",nh=\"Female / Woman\",ih=\"Non-binary / Non-conforming\",sh=\"Free Exclusive PADI Club eCard\",rh=\"Join PADI Club today to get one of three exclusive eCard designs for Club members only, plus a range of insider benefits.\",ch=\"Choose one eCard from three exclusive designs for PADI Club members only. Eligible certifications include Open Water Diver, Advanced Open Water, Rescue Diver, and most scuba specialties.\",lh=\"Choose certification\",dh=\"Get Free eCard\",uh=\"You’ve Redeemed Your Free eCard!\",mh=\"Want another exclusive Club eCard design?\",ph=\"You can apply your annual 25% off PADI Club member discount to another exclusive eCard or a limited edition card made from recycled materials. Use code CLUBCERT25 at checkout to redeem your offer.\",_h=\"Shop Cards\",hh=\"Redeem Your Free eCard?\",gh=\"Please confirm your request to claim your free annual Club exclusive eCard benefit.\",fh=\"eCard Design\",yh=\"Redeem\",bh=\"<strong>Need photo:</strong> We require a profile photo for certification cards\",vh=\"Success! It may take a few minutes for your new eCard to be created and displayed. Please refresh if you don’t see your new eCard appear below with your existing eCards.\",wh=\"Upload a photo\",Ah=\"Certification & Photo Required\",Eh=\"You must have at least one eligible PADI certification and an approved profile photo to take advantage of this benefit. Eligible certifications include Open Water Diver, Advanced Open Water, Rescue Diver, and most scuba specialties.\",Dh=\"Advanced Open Water\",Ih=\"Rescue Diver\",Th=\"ReActivate\",Sh=\"Previous\",Ch=\"Select\",Ph=\"Change Dive Center\",kh=\"PADI Center - Club\",$h=\"Forms & Applications\",Lh=\"You have no digital applications at this time\",Rh=\"Your dive shop would like you to complete the following digital form(s) and applications\",Nh=\"Thank you for submitting your application for review by your Instructor\",Oh=\"Once your Instructor completes their review, they will submit your application to PADI for processing. Please allow 5-7 days for the PADI team to process your application.\",Uh=\"IMPORTANT PAYMENT INFORMATION\",Mh=\"Once the application is processed, PADI will email a secure payment link to allow you to pay the application fee (and AWARE donation if applicable) securely and conveniently using our online payment system.\",qh=\"Go to Learning Dashboard\",Fh=\"View Application\",Gh=\"Submitted to Instructor\",Bh=\"Member Review\",jh=\"Back to Forms & Application\",Vh=\"Where will you work after certification?\",xh=\"We need to know this information so that you get assigned to the appropriate regional PADI office for service.\",Hh=\"Membership Status\",Wh=\"Renewal Date\",zh=\"Auto Renewal\",Yh=\"On\",Jh=\"Off\",Kh=\"My Benefits\",Qh=\"Sign Up\",Zh=\"Reactivate PADI Club\",Xh=\"Free Trial\",eg=\"Active\",tg=\"You are eligible for 90 days free access to PADI Club!\",og=\"You are eligible to join PADI Club!\",ag=\"Your Membership has Expired\",ng=\"Reactivate your Club membership benefits\",ig=\"Sign up now and start accessing full PADI Club benefits. Your way of maintaining your diver status and staying connected, even when you're not in the water!\",sg=\"Sign up now and start accessing full PADI Club benefits for only $26.95 USD/year. Your way of maintaining your diver status and staying connected, even when you're not in the water!\",rg=\"Sign up now and start accessing full PADI Club benefits for only $26.95 for your first 12 months. Your way of maintaining your diver status and staying connected, even when you're not in the water!\",cg=\"As a special partner with PADI, you are welcome to enjoy the full benefits of PADI Club for the special rate of $39.95 USD/year.\",lg=\"Re-activate now and retain your benefits at $49.95/year USD\",dg=\"Re-activate now and retain your benefits for the special PADI partner price of $39.95 USD/year!\",ug=\"Re-activate now and retain your benefits for only $34.95 USD for the next 12 months! Subsequent renewals will be at the regular rate of $49.95 USD.\",mg=\"Reactivate your Club membership today to retain your PADI diver benefits!\",pg=\"i18n Integration\",_g=\"Please review and sign your application.\",hg=\"Beta\",gg=\"Teaching Location updated successfully.\",fg=\"Confirm PADI Professional\",yg=\"Use PADI Dive Shop Locator\",bg=\"Enter your PADI Professional's Store number\",vg=\"Find\",wg=\"Enter your PADI Professional’s Instructor number\",Ag=\"Store number\",Eg=\"Instructor number\",Dg=\"Store number not found. Please try again.\",Ig=\"Instructor number not found. Please try again.\",Tg=\"Instructor name\",Sg=\"Store name\",Cg=\"Please confirm the PADI Professional that you will be taking the in water portion of your experience with.\",Pg=\"Select a city\",kg=\"Buy a Replacement Certification Card\",$g=\"With a PADI eCard<sup>TM</sup>, whenever you have your smartphone, you’ll have proof of your PADI certification. Use the PADI App<sup>TM</sup> to access instantly after purchase.\",Lg=\"Explore Cards\",Rg=\"Book Your Next Course\",Ng=\"Book a Certified Fun Dive\",Og=\"Buy a Certification Card\",Ug=\"Book a Course\",Mg=\"Book a Fun Dive\",qg=\"Explore Certification Cards\",Fg=\"Book your fun dives, snorkelling trips, and courses online with thousands of PADI Dive Centers.\",Gg=\"PADI Review\",Bg=\"Payment Requested\",jg=\"Canceled\",Vg=\"Complete\",xg=\"Application Form\",Hg=\"Medical Form\",Wg=\"Important Notice to Parent/Guardian of Minor Children Participating in Discover Scuba Diving (DSD)\",zg=\"Given the inherent risks of diving, as described above, it is important that both the parent/guardian and any minor child participating in Discover Scuba Diving (DSD) understand, be aware of and accept those risks, and confirm such by both minor child and legal parent/guardian signing below, where indicated, whether or not the parent/guardian is taking part in the DSD program. Minor children will not be accepted into a DSD program without both such signatures being provided.\",Yg=\"Please be advised that the age of majority might differ in the location where you will be taking the Discover Scuba Diving program, check with your PADI Professional to make sure all necessary signatures are obtained.\",Jg=\"Master Scuba Diver Trainer Application\",Kg=\"Open Water Scuba Instructor Application\",Qg=\"Specialty Instructor Application\",Zg=\"Assistant Instructor Application\",Xg=\"Snorkel Guide Application\",ef=\"Alumni Member Application\",tf=\"Course Director Application\",of=\"Discover Scuba Diving Leader\",af=\"IDC Staff Instructor Application\",nf=\"Master Instructor Application\",sf=\"Snorkel Guide Application\",rf=\"Select your country\",cf=\"optional\",lf=\"We have updated our city list, please choose again.\",df=\"Emergency First Response Instructor Application\",uf=\"Divemaster Application\",mf=\"My Scuba Diving Magazine subscription\",pf=\"Join PADI Club!\",_f=\"Don't miss out on your exclusive membership benefits!\",hf=\"Tell Me More\",gf=\"My PADI Club Benefits\",ff=\"Access Benefits\",yf=\"Access Magazine\",bf=\"Signed\",vf=\"Important Notice\",wf=\"If you have any questions or need immediate help, please \",Af=\"Thank you in advance for your patience.\",Ef=\"Your Profile is Incomplete!\",Df=\"To enjoy uninterrupted access to your Club membership, update your payment method now. You will not be charged until your renewal date and can cancel at any time.\",If=\"Do not show me this message again\",Tf=\"Update Now\",Sf=\"Close\",Cf=\"Your access is about to expire\",Pf=\"Update your account to enjoy your benefits without interruption\",kf=\"subscription-logo\",$f={welcome:rt,tax:ct,total:lt,edit:dt,email:ut,phone:mt,cancel:pt,enter_phone_number:_t,thank_you:ht,english:gt,primar