# Phase-1 dev token provider (single account stand-in for per-tenant auth).
# A PADI Cognito refresh token (opaque). The endpoint mints ID tokens from it.
PADI_DEV_REFRESH_TOKEN=
# The PADI affiliate id for that account (the integer in the ID token's
# custom:affiliate_id claim). Optional — derived from a minted token otherwise.
PADI_DEV_AFFILIATE_ID=

# Optional overrides (defaults are correct for PADI prod):
# PADI_ENDPOINT=https://logbook.global-prod.padi.com/api/Logbook
# PADI_COGNITO_REGION=us-west-2
# PADI_COGNITO_CLIENT_ID=2arn5r23p0ugce89a5moe95v1l
