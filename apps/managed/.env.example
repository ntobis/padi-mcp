# --- WorkOS AuthKit (Layer-1 caller auth) ---
WORKOS_API_KEY=sk_test_...            # SECRET — keep local
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD=               # >=32 chars: openssl rand -base64 32
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Your AuthKit domain — the https://<slug>.authkit.app subdomain that serves the
# MCP OAuth endpoints (/oauth2/*). Find it in the WorkOS dashboard under
# Authentication -> Domains (or the Overview page). NOT api.workos.com.
WORKOS_AUTHKIT_DOMAIN=https://your-slug.authkit.app

# --- Encryption (refresh tokens at rest) ---
PADI_MASTER_KEY=                      # 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Database ---
DATABASE_URL=                         # local Postgres or Neon; needed once auth is wired

# --- Phase-1 dev token provider (no longer used by the MCP route; kept for connect-smoke) ---
PADI_DEV_REFRESH_TOKEN=
PADI_DEV_AFFILIATE_ID=

# --- Rate limiting (design 02, Phase 5) ---
# Backend: Upstash Redis sliding-window when both vars are set (durable across
# Vercel's stateless invocations); otherwise an in-memory per-instance fallback.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Per-tenant limits (defaults shown). Private phase keeps these generous.
# RATELIMIT_TOOL_MAX=120          # tool calls per window per user
# RATELIMIT_TOOL_WINDOW_S=60
# RATELIMIT_WRITE_MAX=20          # create/update/delete per window per user
# RATELIMIT_WRITE_WINDOW_S=60
# LOG-ONLY by default. Flip to blocking for the public phase:
# RATELIMIT_ENFORCE=1

# --- Abuse alerting ---
# When a tenant trips a rate limit we log it; if this is set we also POST a JSON
# alert to the webhook (Slack/Discord incoming webhook or any collector).
# ALERT_WEBHOOK_URL=
# Per dedup-key throttle so a hammering client yields one alert per window.
# ALERT_THROTTLE_S=300

# --- Launch controls (kill-switch) ---
# Global maintenance: every PADI/account tool returns service_unavailable (ping
# stays up). Change + redeploy applies in well under a minute.
# SERVICE_DISABLED=1
# SERVICE_DISABLED_MESSAGE=Down for maintenance, back shortly.
# Block specific WorkOS user ids from the PADI tools (they may still
# disconnect/export/delete their own data). Comma-separated.
# BANNED_USER_IDS=

# Optional overrides (defaults are correct for PADI prod):
# PADI_ENDPOINT=https://logbook.global-prod.padi.com/api/Logbook
# PADI_COGNITO_REGION=us-west-2
# PADI_COGNITO_CLIENT_ID=2arn5r23p0ugce89a5moe95v1l
