# --- WorkOS AuthKit (Layer-1 caller auth) ---
WORKOS_API_KEY=sk_test_...            # SECRET — keep local
WORKOS_CLIENT_ID=client_...
WORKOS_COOKIE_PASSWORD=               # >=32 chars: openssl rand -base64 32
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Your AuthKit domain — the https://<slug>.authkit.app subdomain that serves the
# MCP OAuth endpoints (/oauth2/*). Find it in the WorkOS dashboard under
# Authentication -> Domains (or the Overview page). NOT api.workos.com.
WORKOS_AUTHKIT_DOMAIN=https://your-slug.authkit.app

# --- Encryption (refresh tokens at rest) ---
PADI_MASTER_KEY=                      # 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Database ---
DATABASE_URL=                         # local Postgres or Neon; needed once auth is wired

# --- Phase-1 dev token provider (no longer used by the MCP route; kept for connect-smoke) ---
PADI_DEV_REFRESH_TOKEN=
PADI_DEV_AFFILIATE_ID=

# Optional overrides (defaults are correct for PADI prod):
# PADI_ENDPOINT=https://logbook.global-prod.padi.com/api/Logbook
# PADI_COGNITO_REGION=us-west-2
# PADI_COGNITO_CLIENT_ID=2arn5r23p0ugce89a5moe95v1l
